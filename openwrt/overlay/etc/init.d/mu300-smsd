#!/bin/sh /etc/rc.common
# keep the local SMS pool in step with the SIM (see /opt/mu300/bin/mu300-smsd)
START=95
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

start_service() {
	[ -c /dev/stty_nr1 ] || return 0
	procd_open_instance smsd
	procd_set_param command /opt/mu300/bin/mu300-smsd
	# /var is tmpfs on OpenWrt; the pool is small and worth keeping across reboots
	procd_set_param env MU300_SMS_POOL=/etc/mu300/sms
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
