#!/bin/sh
# Event-driven reconciliation for state changes that are not owned by
# mobile-data. No fixed startup sleeps: hostapd/netifd readiness drives it.
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"

wifi_state() {
    if ubus call hostapd.wlan0 get_status 2>/dev/null | grep -q '"status": "ENABLED"'; then
        led-status wifi-on
    else
        led-status wifi-off
    fi
}

network_state() {
    if ubus call network.interface.wan status 2>/dev/null | grep -q '"up": true'; then
        case "$(led-status current 2>/dev/null)" in
            online-4g) led-status online-4g; return ;;
            online-5g) led-status online-5g; return ;;
        esac
        act=$(mu300-at -t 3 'AT+CEREG?' 2>/dev/null | grep '+CEREG:' | head -1 | awk -F, '{print $NF}' | tr -d '" ')
        case "$act" in
            11|12|13|15) led-status online-5g ;;
            *)           led-status online-4g ;;
        esac
    else
        led-status offline
    fi
}

network_state
wifi_state
ubus listen 2>/dev/null | while IFS= read -r event; do
    case "$event" in
        *network.interface*) network_state ;;
        *network.wireless*|*hostapd*) wifi_state ;;
    esac
done
