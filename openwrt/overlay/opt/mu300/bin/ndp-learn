#!/bin/sh
# Watch the LAN for public SLAAC addresses (odhcpd relay hands the carrier's /64 to
# clients) and pin a host route for each one. Without it, a reply coming back through
# NAT66 follows sipa_eth0's connected /64 route and dies on the wrong interface -
# measured: ICMP 100% loss, TCP connect timeouts, until the /128 exists.
while :; do
    for a in $(ip -6 neigh show dev br-lan 2>/dev/null | cut -d' ' -f1 |
               grep -E '^[23][0-9a-f]*:'); do
        ip -6 route show "$a/128" 2>/dev/null | grep -q 'dev br-lan' ||
            ip -6 route add "$a/128" dev br-lan 2>/dev/null
    done
    # self-heal the bearer's own public address: the carrier's RA can be missed while the
    # bearer settles after boot, and nothing else ever re-solicits - flip accept_ra to send
    # a fresh router solicitation whenever the bearer has no global address
    if ! ip -6 addr show sipa_eth0 2>/dev/null | grep -q 'scope global'; then
        echo 0 > /proc/sys/net/ipv6/conf/sipa_eth0/accept_ra 2>/dev/null
        sleep 1
        echo 2 > /proc/sys/net/ipv6/conf/sipa_eth0/accept_ra 2>/dev/null
    fi
    sleep 10
done
