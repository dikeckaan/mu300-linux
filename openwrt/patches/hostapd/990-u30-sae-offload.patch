+/* Explicit U30-only switch: configure the SC2355 firmware SAE password.
+ * The vendor contract is OUI 0x001374, subcommand 43, attributes 8/6/7. */
+static int u30_sae_configure_fw(struct hostapd_data *hapd)
+{
+	const char *password = hapd->conf->ssid.wpa_passphrase;
+	u8 data[84], digest[32];
+	const u8 *parts[1];
+	size_t sizes[1], len, attr_len, total;
+	int ret;
+	if (!hapd->conf->u30_sae_offload)
+		return 0;
+	/* Only the observed firmware H&P/group-19 path is supported. */
+	if (hapd->conf->wpa_key_mgmt != WPA_KEY_MGMT_SAE ||
+	    hapd->conf->ieee80211w != MGMT_FRAME_PROTECTION_REQUIRED ||
+	    hapd->conf->sae_pwe != 0 || hapd->conf->sae_passwords ||
+	    (hapd->iface->drv_flags2 & WPA_DRIVER_FLAGS2_AP_SME)) {
+		wpa_printf(MSG_ERROR, "U30 SAE: requires pure SAE, mandatory PMF, sae_pwe=0 and firmware AP SME");
+		return -1;
+	}
+	if (!password || (len = os_strlen(password)) < 8 || len > 63)
+		return -1;
+	parts[0] = (const u8 *) password; sizes[0] = len;
+	if (sha256_vector(1, parts, sizes, digest))
+		return -1;
+	if (hapd->u30_sae_configured &&
+	    os_memcmp_const(digest, hapd->u30_sae_key_fingerprint, 32) == 0) {
+		forced_memzero(digest, sizeof(digest));
+		return 0;
+	}
+	os_memset(data, 0, sizeof(data));
+	attr_len = len + 4;
+	WPA_PUT_LE16(data, attr_len); WPA_PUT_LE16(data + 2, 8);
+	os_memcpy(data + 4, password, len);
+	total = (attr_len + 3) & ~3;
+	WPA_PUT_LE16(data + total, 8); WPA_PUT_LE16(data + total + 2, 6);
+	WPA_PUT_LE32(data + total + 4, 19); total += 8;
+	WPA_PUT_LE16(data + total, 8); WPA_PUT_LE16(data + total + 2, 7);
+	WPA_PUT_LE32(data + total + 4, 0xffffffff); total += 8;
+	hapd->u30_sae_configured = 0;
+	ret = hostapd_drv_vendor_cmd(hapd, 0x001374, 43, data, total,
+				     NESTED_ATTR_USED, NULL);
+	forced_memzero(data, sizeof(data));
+	if (!ret) {
+		os_memcpy(hapd->u30_sae_key_fingerprint, digest, sizeof(digest));
+		hapd->u30_sae_configured = 1;
+		wpa_printf(MSG_INFO, "U30 SAE: firmware runtime parameters configured");
+	} else {
+		wpa_printf(MSG_ERROR, "U30 SAE: firmware configuration failed (%d)", ret);
+	}
+	forced_memzero(digest, sizeof(digest));
+	return ret;
+}
