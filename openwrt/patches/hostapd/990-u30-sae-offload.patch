+/* SPDX-License-Identifier: BSD-3-Clause
+ * SC2355 kernel NEW_STATION metadata; never parse this from an over-the-air frame.
+ */
+#ifndef U30_SAE_OFFLOAD_H
+#define U30_SAE_OFFLOAD_H
+
+static inline const u8 * u30_sae_get_key(const u8 *ies, size_t len)
+{
+	const u8 *key = NULL;
+	size_t offset = 0;
+	unsigned int matches = 0;
+
+	if (!ies)
+		return NULL;
+	while (len - offset >= 2) {
+		size_t element_len = 2 + ies[offset + 1];
+
+		if (element_len > len - offset)
+			return NULL;
+		if (ies[offset] == WLAN_EID_VENDOR_SPECIFIC && element_len == 54 &&
+		    os_memcmp(ies + offset + 2, "\x40\x45\xda\x04", 4) == 0) {
+			matches++;
+			if (element_len == len - offset)
+				key = ies + offset + 6;
+		}
+		offset += element_len;
+	}
+	return offset == len && matches == 1 ? key : NULL;
+}
+
+#endif /* U30_SAE_OFFLOAD_H */
