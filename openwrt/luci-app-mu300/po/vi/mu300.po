msgstr "Khóa cell %s?"

msgid "The radio stack will restart (SFUN); cellular service will stop for about 30 seconds."
msgstr "Ngăn xếp radio sẽ khởi động lại (SFUN); dịch vụ di động sẽ dừng khoảng 30 giây."

msgid "Locking %s in the background, about 30 seconds"
msgstr "Đang khóa %s trong nền, khoảng 30 giây"

msgid "Locked %s in the background; the status will refresh shortly"
msgstr "Đã khóa %s trong nền; trạng thái sẽ sớm được làm mới"

msgid "Lock failed: %s"
msgstr "Khóa thất bại: %s"

msgid "Resetting the network locks to automatic (SFUN restart, about 30 seconds)…"
msgstr "Đang đặt lại khóa mạng về tự động (khởi động lại SFUN, khoảng 30 giây)…"

msgid "The lock reset was not confirmed in time; switching anyway."
msgstr "Không xác nhận kịp việc đặt lại khóa; vẫn chuyển."

