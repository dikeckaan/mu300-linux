msgstr "Dihapus (lokal + SIM)"

msgid "Deleted (local only)"
msgstr "Dihapus (hanya lokal)"

msgid "Enter both a number and a message."
msgstr "Masukkan nomor dan pesan."

msgid "Sending…"
msgstr "Mengirim…"

msgid "Sent; the list refreshes shortly."
msgstr "Terkirim; daftar akan segera disegarkan."

msgid "Sending failed"
msgstr "Gagal mengirim"

msgid "· %d messages, %d unread · %d conversations"
msgstr "· %d pesan, %d belum dibaca · %d percakapan"

msgid "· %d messages · %d conversations"
msgstr "· %d pesan · %d percakapan"

