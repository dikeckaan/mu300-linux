#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	procd_open_instance boot-lock-replay
	procd_set_param command /usr/libexec/unisoc-modem/boot-replay
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger unisoc_modem
}
