#!/usr/bin/ucode
// mu300-dash-cell -- the dashboard's cellular collector: modem/cell/SIM readings into ONE
// cached JSON in the package runtime directory, written by whoever refreshes it.
//
// The web page NEVER runs this directly and never waits for it: the rpcd backend
// (mu300status in rpcd, or /usr/libexec/rpcd/mu300dash) serves the cache and kicks a background refresh
// (setsid) whenever it is older than the TTL. That separation is the one hard rule
// the V50 panel learned in the field: a synchronous AT round inside a web request
// starves the AT channel, the dial watchdog then sees a dead modem and the box
// ends up rebooting itself (docs/FINDINGS.md, V50 archive "45g").
//
// A ucode program since the home page's CPU work (FINDINGS 216): the shell version paid ~60 ms of CPU per AT command
// (the adapter, mu300-at and their forks: ~48 ms on the client side alone) and ~0.5 s per fast round, every 1.5 s
// while the home page was open. The commands, the files, the locks and the JSON are the same as before. With the
// platform's mu300-atd (the "mu300" backend) the commands go to the daemon directly, by mu300-at's own protocol
// (the client lock $DIR/lock, one "T ANSWER-FILE COMMAND" line on the fifo, the answer file); any other backend, or
// an adapter named in MU300_AT (the tests), is run as before.
//
// Commands per round (about 10, roughly one second on this modem):
//   AT+CFUN?            radio on/off - the honest state for the toggle
//   AT+COPS?            operator name + access technology
//   AT+CEREG?           LTE registration, TAC, cell ID
//   AT+C5GREG?          NR registration - CEREG alone still reports LTE-style AcT on n78
//   AT+CESQ             RSRP/RSRQ indexes - the fallback when the engineering mode below says nothing
//   AT+SPENGMD=0,6,0    Unisoc engineering: LTE serving cell (band/EARFCN/PCI/RSRP/RSRQ/bandwidth/ECI/TAC)
//   AT+SPENGMD=0,14,1   NR serving cell (band/ARFCN/PCI/RSRP/RSRQ/SINR/MCS/BLER)
//   AT+SPENGMD=0,6,6    LTE neighbour slots (8 x 12 fields, first 4 per slot are the reading)
//   AT+SPQ5GNCELLEX     NR neighbour table with real per-cell SINR
//   AT+CGEQOSRDP=<cid>  QCI + up/down AMBR of the bearer the WAN uses now (its CID from netifd's live device)
//   AT+CNUM             the SIM's own number (full rounds only, until one is found; see "own number" below)
//   AT+SPPAURI?         the IMS public identity, when the SIM has no number
// AT+SPENGMD=0,1,0 is NEVER sent: it switches the AT port into streaming mode and
// kills the channel until the next reboot (V50 archive; blacklisted in the rpcd
// AT terminal too).
//
// SIM/module identity (IMEI/IMSI/ICCID/model/firmware) changes only when the SIM
// or the firmware changes, so it lives in the configured state directory and is re-read
// at most every 6 hours once complete (a partial read: every minute) - not on every
// round, and never inside a page request.
//
// Two rounds share this program:
//   cell          full: everything below, ~11 commands, neighbours included
//   cell fast     serving-cell tier: CFUN/CEREG/C5GREG/CESQ + the two
//                 SPENGMD serving reads (~6 commands, well under a second),
//                 written to sig.json only - the slow tier (neighbours, operator, QoS, identity)
//                 rides the full cache. A fast round yields to a full
//                 round in flight (the full round writes sig.json too).
'use strict';

import { readfile, stat, lstat, mkdir, rmdir, unlink, open, rename, access, chmod, lsdir, popen, readlink } from 'fs';
import { safe_iface, safe_state_dir, data_cid, lines, first_with, after_prefix, eng_line, n_or_null, anum, fmt1,
	ident_token, iccid_value, cnum_number, ims_number, sp_lte, sp_nr, sp_ltenb, nr_neighbours, reg_fragment,
	cops_fragment, cesq_fragment, qos_fragment, reg_stat, FINAL } from 'mu300.cellparse';

function env(name, dflt) {
	let v = getenv(name);
	return (v != null && v != '') ? v : dflt;
}
function rd(path) { let s = readfile(path); return (s == null) ? '' : rtrim(s, '\n'); }
function exists(path) { return lstat(path) != null; }
function is_fifo(path) { return stat(path)?.type == 'fifo'; }
function executable(path) { let s = stat(path); return s != null && s.type == 'file' && access(path, 'x') == true; }
function now() { return time(); }
function shq(s) { return "'" + replace('' + s, "'", "'\\''") + "'"; }
function mypid() { let s = readfile('/proc/self/stat'); return +substr(s, 0, index(s, ' ')); }
const PID = mypid();

// rm -rf for the small lock directories here (files and one level of directories)
function rm_rf(path) {
	let l = lstat(path);
	if (!l)
		return;
	if (l.type == 'directory') {
		for (let f in lsdir(path) ?? [])
			rm_rf(path + '/' + f);
		rmdir(path);
	}
	else
		unlink(path);
}
// write TEXT to PATH whole: PATH.part first (owner only), then moved into place
function publish(path, text) {
	let f = open(path + '.part', 'w', 0600);
	if (!f)
		return false;
	f.write(text);
	f.close();
	return rename(path + '.part', path) == true;
}
function jstr(v) { return sprintf('%J', v); }

// ---------------------------------------------------------------- lib.sh, the parts used here
let uci = null;
try { uci = require('uci'); } catch (e) { }
let cur = uci ? uci.cursor() : null;
function uget(conf, sec, opt) {
	if (!cur)
		return '';
	let v = cur.get(conf, sec, opt);
	return (type(v) == 'array') ? join(' ', v) : ((v == null) ? '' : '' + v);
}
function uci_get(opt) { return uget('unisoc_modem', 'main', opt); }
// data_cid DEVICE SLOT: the PDP context behind a SIPA data device of SIM slot SLOT, or null
// private_dir: DIR created owner-only; refused when it is a symlink, not a directory, not ours, or writable by others
function private_dir(dir) {
	if (!exists(dir)) {
		mkdir(replace(dir, /\/[^\/]*$/, ''));
		mkdir(dir, 0700);
	}
	let l = lstat(dir);
	let uid = +(match(rd('/proc/self/status'), /\nUid:[ \t]*([0-9]+)/)?.[1] ?? '0');
	if (!l || l.type != 'directory' || l.uid != uid) {
		warn('unisoc-modem: refusing the runtime directory ' + dir + ': a symlink, not a directory, or not ours\n');
		return false;
	}
	if (l.perm?.group_write || l.perm?.other_write) {
		warn('unisoc-modem: refusing the runtime directory ' + dir + ': writable by group or others\n');
		return false;
	}
	chmod(dir, 0700);
	return true;
}

const MODE = ARGV[0] ?? 'full';
const RUN_DIR = '/var/run/unisoc-modem';
const DIR = env('MU300_DASH_DIR', RUN_DIR);
const CELL = DIR + '/cell.json';
const SIGF = DIR + '/sig.json';
let STATE_DIR = safe_state_dir(uci_get('state_dir'), '');
let IDENT_DIR = env('MU300_DASH_IDENT_DIR', replace(STATE_DIR, /\/lock-state\.d$/, ''));
if (IDENT_DIR == '')
	IDENT_DIR = '/etc/unisoc-modem';
let IDENT = IDENT_DIR + '/sim.json';
const AT_ADAPTER = env('MU300_AT', '/usr/libexec/unisoc-modem/at');
const IDENT_MAXAGE = 21600;   // seconds; a SIM change goes through a reboot, 6 h is plenty
const IDENT_RETRY = 60;       // seconds a partial identity (modem or SIM not ready) is shown before it is asked again

// a runtime directory someone else made is refused: write nothing
if (!private_dir(DIR))
	exit(1);
mkdir(IDENT_DIR);

// nr3/nr4/nr5 belong to SIM slot 1 and return the wrong state for slot 0.
// The dashboard therefore uses the two verified slot-0-capable optional
// channels nr6/nr7; nr1 is only the final fallback for a failed pool channel.
let SIM_SLOT = '0';
if (executable('/opt/mu300/bin/mu300-sim')) {
	// mu300-sim's own short way first: the pinned slot 0 is one file. The status plugin, which asks the selector
	// every few seconds anyway, hands its answer down (MU300_DASH_SIM_SLOT): on the U30 Air the selector is a 13 ms
	// script run, a third of a fast round.
	if (match(getenv('MU300_DASH_SIM_SLOT') ?? '', /^[01]$/))
		SIM_SLOT = getenv('MU300_DASH_SIM_SLOT');
	else if (rd('/run/mu300/sim-slot') == '0')
		SIM_SLOT = '0';
	else {
		let p = popen('/opt/mu300/bin/mu300-sim active 2>/dev/null', 'r');
		let out = p ? p.read('all') : null;
		if (!p || p.close() != 0)
			exit(1);
		SIM_SLOT = replace(out ?? '', /\n+$/, '');
	}
}
let SIM_NATIVE = exists('/run/mu300-radio-freeze');
let ATC = env('MU300_DASH_AT_DIR', '');
let DASH_CHANNELS = [ '6', '7' ];
let DASH_FALLBACKS = [ '/run/mu300-at6', '/run/mu300-at7', '/run/mu300-at' ];
if (SIM_SLOT == '1') {
	ATC = '/run/mu300-at';
	DASH_CHANNELS = [ '4' ];
	DASH_FALLBACKS = [ '/run/mu300-at' ];
	IDENT = IDENT_DIR + '/sim-slot1.json';
}
if (SIM_NATIVE) {
	if (SIM_SLOT == '0') { DASH_CHANNELS = [ '1' ]; DASH_FALLBACKS = [ '/run/mu300-at' ]; }
	else if (SIM_SLOT == '1') { DASH_CHANNELS = [ '4' ]; DASH_FALLBACKS = [ '/run/mu300-at4' ]; }
	else exit(2);
}

// A whole round has a deadline (MU300_DASH_DEADLINE seconds from now; 25 for a full round, 12 for a fast one).
// Without one, a modem that stopped answering held a collector for many minutes. Past the deadline every further
// command fails at once; each one gets at most what is left.
let dl = getenv('MU300_DASH_DEADLINE');
const DEADLINE = now() + ((dl != null && match(dl, /^[0-9]+$/)) ? +dl : ((MODE == 'fast') ? 12 : 25));

// ------------------------------------------------------------------ AT
// The backend the adapter (unisoc-modem/at) would take: "mu300" when it would run mu300-at, which then talks to
// mu300-atd - and so can this program, without the adapter and mu300-at in between.
function native_backend() {
	if (getenv('MU300_AT') != null && getenv('MU300_AT') != '')
		return false;
	let backend = uci_get('at_backend');
	if (backend == '')
		backend = 'auto';
	if (backend != 'auto' && backend != 'mu300')
		return false;
	return executable('/opt/mu300/bin/mu300-at') || executable('/usr/bin/mu300-at');
}
const NATIVE = native_backend();

function alive(pid) { return match('' + pid, /^[0-9]+$/) && exists('/proc/' + pid); }
function cmdline(pid) { let c = readfile('/proc/' + pid + '/cmdline'); return (c == null) ? '' : replace(c, /\0/g, ' '); }

// mu300-at's daemon path, as `MU300_AT_LOCK_WAIT=0 MU300_AT_BUDGET=LEFT MU300_AT_DIR=D mu300-at -t T CMD` runs it:
// the reply (CRs and all), or null for "busy", "no answer" or "no final result code"
function atd_command(d, t, left, cmd) {
	// a live SIM switch holds the channels for its own commands (mu300-at's sim-sequence rule, with flock): the
	// adapter, which can take that lock, decides
	if (exists('/run/mu300/sim-sequence'))
		return adapter_command(d, t, left, cmd);
	if (access(d, 'w') != true || access(d + '/cmd', 'w') != true)
		return null;
	let budget = t + 2;
	let owner = rd(d + '/owner/pid');
	if (owner != '' && index(cmdline(owner), 'mu300-atd') >= 0)
		budget = t + 31;
	if (left < budget)
		budget = left;
	// the client lock, not waited for (MU300_AT_LOCK_WAIT=0): a stale one is taken over as mu300-at does
	let lock = d + '/lock';
	while (!mkdir(lock)) {
		let o = rd(lock + '/pid');
		if (o != '' && !alive(o)) { rm_rf(lock); continue; }
		if (o != '' && index(cmdline(o), 'mu300-atd') >= 0) { rm_rf(lock); continue; }
		let due = rd(lock + '/until');
		if (o != '' && match(due, /^[0-9]+$/) && now() > +due && index(cmdline(o), 'mu300-at') >= 0) {
			warn('mu300-at: pid ' + o + ' held the AT lock past its own deadline; ending it\n');
			system('kill -9 ' + o + ' 2>/dev/null');
			rm_rf(lock);
			continue;
		}
		return null;   // busy
	}
	let answer = d + '/answer.' + PID;
	let fifo = null;
	let exchange = () => {
		let f = open(lock + '/pid', 'w', 0600); if (f) { f.write(PID + '\n'); f.close(); }
		f = open(lock + '/until', 'w', 0600); if (f) { f.write((now() + budget + 10) + '\n'); f.close(); }
		unlink(answer); unlink(answer + '.part');
		// the fifo read-write: never blocks, and the command stays buffered while the daemon has it closed (mu300-at
		// keeps it open until the answer is in: the kernel drops buffered data when the last descriptor closes)
		if (!is_fifo(d + '/cmd'))
			return null;
		fifo = open(d + '/cmd', 'r+');
		if (!fifo || !is_fifo(d + '/cmd'))
			return null;
		if (fifo.write(t + ' ' + answer + ' ' + cmd + '\n') == null)
			return null;
		fifo.flush();
		// the daemon typically answers in ~20 ms: a look every 10 ms
		let end = now() + budget;
		while (stat(answer) == null) {
			if (now() >= end)
				return null;
			sleep(10);
		}
		// atd always creates the answer file, even for a timeout: only a final result code is an answer
		let a = readfile(answer) ?? '';
		return match(a, FINAL) ? a : null;
	};
	let reply = null;
	try { reply = exchange(); }
	catch (e) { reply = null; }
	if (fifo)
		fifo.close();
	unlink(answer); unlink(answer + '.part');
	if (rd(lock + '/pid') == '' + PID)
		rm_rf(lock);
	return reply;
}

// the adapter, as the shell collector ran it
function adapter_command(d, t, left, cmd) {
	let envs = 'MU300_AT_LOCK_WAIT=0 MU300_AT_BUDGET=' + left + ((d != null) ? ' MU300_AT_DIR=' + shq(d) : '');
	let p = popen(envs + ' ' + shq(AT_ADAPTER) + ' -t ' + t + ' ' + shq(cmd) + ' 2>/dev/null', 'r');
	if (!p)
		return null;
	let out = p.read('all');
	return (p.close() == 0) ? (out ?? '') : null;
}

let ATC_SET = ATC;
function at(cmd, timeout) {
	timeout ??= 5;
	let seen = {};
	let any = false;
	// The assigned regular channel is first. A silent channel fails in about
	// timeout+1 seconds; only then touch the two unpolled disaster channels.
	for (let d in [ ATC_SET, ...DASH_FALLBACKS ]) {
		if (d == null || d == '' || !is_fifo(d + '/cmd') || seen[d])
			continue;
		seen[d] = true;
		any = true;
		let left = DEADLINE - now();
		if (left < 1)
			return '';
		// the daemon's drain and collect: T + 4 s is plenty for an answer that comes at all
		if (left > timeout + 4)
			left = timeout + 4;
		let out = NATIVE ? atd_command(d, timeout, left, cmd) : adapter_command(d, timeout, left, cmd);
		if (out == null)
			continue;
		return replace(out, /\r/g, '');
	}
	// no daemon directory at all: the adapter's own backend, without waiting for anybody's lock
	if (any)
		return '';
	let left = DEADLINE - now();
	if (left < 1)
		return '';
	let out = adapter_command(null, timeout, left, cmd);
	return (out == null) ? '' : replace(out, /\r/g, '');
}
// the first line of TEXT starting with PREFIX (grep '^PREFIX' | head -n1), '' for none
// sed -n 's/^PREFIX *//p' | head -n1
// grep -v '^AT' | grep -- '-' | head -n1: an engineering answer line (never the echo)

// iccid_value ICCID: upper case; the F that pads a 19-digit ICCID to 20 nibbles is dropped
function ident_complete(path) {
	let s = readfile(path) ?? '';
	return match(s, /"imei":"[0-9]/) && match(s, /"imsi":"[0-9]/) && match(s, /"iccid":"[0-9A-F]/);
}
function file_age(path) { let s = stat(path); return now() - (s ? s.mtime : 0); }

// ims_number: the operator-provisioned IMS public identity (AT+SPPAURI?): a tel: URI first, else a sip:/sips: URI whose
// user part is an international number (a bare numeric SIP user part is the IMSI on many networks)

// --------------------------------------------------------------- one collector
// the same "one owner, spare waits/takes over" pattern mu300-atd uses, so two
// kicks (page reload while a refresh runs) cannot interleave AT replies
// a collector: this program, or the modem daemon in a round of its own (mu300-modemd, FINDINGS 216)
function collector(pid) {
	if (!alive(pid))
		return false;
	let c = cmdline(pid);
	return index(c, '/unisoc-modem/cell') >= 0 || index(c, 'mu300-modemd') >= 0;
}
const LOCK = DIR + '/collect.lck';
while (!mkdir(LOCK)) {
	let owner = rd(LOCK + '/pid');
	if (collector(owner))
		exit(0);
	// mkdir and writing pid are two operations: an empty pid is the acquisition window of a live peer
	if (owner == '')
		exit(0);
	rm_rf(LOCK);
}
let held = [ LOCK ];
function release() { for (let p in held) rm_rf(p); }
function write_pid(dir) { let f = open(dir + '/pid', 'w', 0600); if (f) { f.write(PID + '\n'); f.close(); } }
write_pid(LOCK);

// Claim one of the physical dashboard channels without waiting. This caps
// work even when browsers overlap polls: a third collector is discarded and
// the next refresh retries. Stale slots are reclaimed by PID ownership.
const POOL = env('MU300_DASH_POOL_DIR', '/run/unisoc-modem-at-pool');
mkdir(POOL);
let SLOT = null;
for (let n in DASH_CHANNELS) {
	let channel_dir = '/run/mu300-at' + n;
	if (SIM_SLOT == '1' && !SIM_NATIVE)
		channel_dir = '/run/mu300-at';
	let s = POOL + '/nr' + n;
	if (mkdir(s)) { SLOT = s; ATC_SET = channel_dir; break; }
	let owner = rd(s + '/pid');
	if (owner != '' && !collector(owner)) {
		rm_rf(s);
		if (mkdir(s)) { SLOT = s; ATC_SET = channel_dir; break; }
	}
}
if (!SLOT) {
	release();
	exit(0);
}
push(held, SLOT);
write_pid(SLOT);

// the scalar part of a token, sign restored ("+11747" -> -11747); '' for none, NA or N/A
// large ids (the NR cell id is 36 bits) as strings; "+N" is 2^32 - N

// operator_name COPS: when the modem answers in the numeric format, the long name - one line that asks for it and
// puts the numeric format back - with the character set. Once per PLMN: kept in the runtime directory as
// "PLMN CSCS" and the named line. Returns [named line, character set].
function operator_name(cops) {
	let f = DIR + '/operator';
	if (match(cops, /^\+COPS: [0-9],[01],"/)) {
		if (!match(cops, /^[^"]*"([0-9A-Fa-f]{4})+"/))
			return [ '', '' ];
		let cscs = rd(DIR + '/cscs');
		if (cscs == '') {
			cscs = after_prefix(at('AT+CSCS?', 2), '+CSCS:');
			let m = match(cscs, /^"([A-Za-z0-9_]*)"/);
			cscs = m ? m[1] : '';
			if (cscs != '')
				publish(DIR + '/cscs', cscs + '\n');
		}
		return [ '', cscs ];
	}
	let m = match(cops, /^\+COPS: *[0-9]*, *2, *"([0-9]{5,6})"/);
	if (!m)
		return [ '', '' ];
	let plmn = m[1];
	let cached = lines(readfile(f) ?? '');
	if (length(cached) && replace(cached[0], / .*/, '') == plmn)
		return [ cached[1] ?? '', (index(cached[0], ' ') >= 0) ? replace(cached[0], /^[^ ]* /, '') : '' ];
	let out = at('AT+CSCS?;+COPS=3,0;+COPS?;+COPS=3,2', 3);
	let named = '';
	for (let l in lines(out))
		if (match(l, /^\+COPS: *[0-9]*, *[01], *"/)) { named = l; break; }
	let cs = '';
	for (let l in lines(out)) {
		let c = match(l, /^\+CSCS: *"([A-Za-z0-9_]*)"/);
		if (c) { cs = c[1]; break; }
	}
	if (named == '')
		return [ '', '' ];
	publish(f, plmn + ' ' + ((cs != '') ? cs : 'unknown') + '\n' + named + '\n');
	return [ named, (cs != '') ? cs : 'unknown' ];
}

// netifd's account of the data interface, nothing when there is none
let ubus = null;
try { ubus = require('ubus'); } catch (e) { }
let bus = null;
function wan_status() {
	if (!ubus)
		return null;
	bus ??= ubus.connect(null, 2);
	return bus ? bus.call('network.interface.' + safe_iface(uci_get('data_interface'), 'wan'), 'status', {}) : null;
}
// bearer_qos: the +CGEQOSRDP answer (without its prefix) for the bearer the WAN is on now, or ''. The CID comes from
// netifd's live device, and afterwards the WAN must still be the same connection - up, on the same device, its uptime
// not started over - or the previous bearer's numbers would be shown for the new one.
function bearer_qos() {
	let st = wan_status();
	if (!st || st.up !== true)
		return '';
	let dev = safe_iface(st.l3_device, '');
	let cid = data_cid(dev, SIM_SLOT);
	if (cid == null)
		return '';
	let age = st.uptime;
	if (type(age) != 'int')
		return '';
	let reply = after_prefix(at('AT+CGEQOSRDP=' + cid, 2), '+CGEQOSRDP:');
	let c = replace(reply, /,.*/, '');
	if (!(c == '' + cid || c == ' ' + cid || c == cid + ' '))
		return '';
	let st2 = wan_status();
	if (!st2 || st2.up !== true || st2.l3_device != dev || type(st2.uptime) != 'int' || st2.uptime < age)
		return '';
	return reply;
}
// "+CGEQOSRDP: 1,9,..OK" (this modem glues OK onto the line)

// at_group CMDS TIMEOUT: the standard reads whose answers carry their own prefix (+CFUN:, +CEREG:, ...) in ONE request
// ("AT+CFUN?;+CEREG?;..."): mu300-atd's cost is per request (its forks), not per line. The answer is taken only
// when it ends in OK and has every prefix; anything else (a modem that refuses one of them, or the whole line) and
// each command is asked on its own, as before. Returns the answers, one text per command.
function at_group(cmds, timeout) {
	let prefix = (c) => replace(replace(c, /^AT/, ''), /[?=].*$/, '') + ':';
	let all = at('AT' + join(';', map(cmds, (c) => substr(c, 2))), timeout + 1);
	let ok = match(all, /(^|\n)OK(\n|$)/) != null;
	for (let c in cmds)
		if (first_with(all, prefix(c)) == '')
			ok = false;
	return map(cmds, (c) => ok ? all : at(c, timeout));
}

// ---------------------------------------------------------- staged AT round
// The cheap, universally available core first (one request); a full round publishes it before its slower tier, so
// the UI can show radio, registration and CESQ while the engineering/identity reads continue.
let core = at_group((MODE == 'full') ? [ 'AT+CFUN?', 'AT+CEREG?', 'AT+C5GREG?', 'AT+CESQ', 'AT+COPS?' ]
                                     : [ 'AT+CFUN?', 'AT+CEREG?', 'AT+C5GREG?', 'AT+CESQ' ], 2);
let CFUN = after_prefix(core[0], '+CFUN:');
let CEREG = first_with(core[1], '+CEREG:');
let C5GREG = first_with(core[2], '+C5GREG:');
let CESQ = first_with(core[3], '+CESQ:');
let REG = reg_fragment(CEREG), REG5 = reg_fragment(C5GREG), CESQJ = cesq_fragment(CESQ), CFUNN = n_or_null(CFUN);
if (MODE != 'fast')
	publish(SIGF, jstr({ ts: now(), partial: 1, cfun: CFUNN, reg: REG, reg5g: REG5, sig_src: 'cesq', sig: CESQJ,
		lte: null, nr: null }) + '\n');

let R4 = reg_stat(CEREG), R5 = reg_stat(C5GREG);
let REGISTERED = (R4 in [ '1', '5', '10' ]) || (R5 in [ '1', '5', '10' ]);
// Camped on 5G SA, CEREG reports the NR access technology (11) itself: there is no LTE anchor, and the LTE serving
// and PHY reads answer all zeros (no reading, lte null). They are not asked then.
let NR_SA = REG != null && REG.act == 11;
let SP_LTE = '', SP_LTEPHY = '', SP_NR = '', SP_LN = '', SP_NRNB = '', QOS = '', COPS = '', OPN = [ '', '' ];
if (REGISTERED) {
	if (!NR_SA) {
		SP_LTE = eng_line(at('AT+SPENGMD=0,6,0', 2));
		SP_LTEPHY = eng_line(at('AT+SPENGMD=0,0,6', 2));
	}
	SP_NR = eng_line(at('AT+SPENGMD=0,14,1', 2));
}
let IDENT_JSON = null, i_msisdn = '', i_msisdn_src = '';
if (MODE == 'full') {
	COPS = first_with(core[4], '+COPS:');
	OPN = operator_name(COPS);
	if (REGISTERED) {
		SP_LN = eng_line(at('AT+SPENGMD=0,6,6', 2));
		SP_NRNB = after_prefix(at('AT+SPQ5GNCELLEX', 2), '+SPQ5GNCELLEX:');
		QOS = bearer_qos();
	}
	// The 6 h cache on flash holds a complete identity only: IMEI, IMSI and ICCID all read. A partial read is shown
	// for this round and kept in the runtime directory for a minute, then asked again, and it never replaces a
	// complete cache (an expired complete one is served meanwhile).
	let IDENT_PART = DIR + '/' + replace(IDENT, /.*\//, '') + '.partial';
	let ident_text = null;
	let parse = (s) => { try { let v = json(s); return (type(v) == 'object') ? v : null; } catch (e) { return null; } };
	if (stat(IDENT)?.size > 0 && ident_complete(IDENT) && file_age(IDENT) <= IDENT_MAXAGE)
		ident_text = readfile(IDENT);
	else if (stat(IDENT_PART)?.size > 0 && file_age(IDENT_PART) <= IDENT_RETRY)
		ident_text = readfile(IDENT_PART);
	if (ident_text != null)
		IDENT_JSON = parse(ident_text);
	else {
		let first_ok = (t) => { for (let l in lines(t)) if (!match(l, /^OK/)) return l; return ''; };
		let i_mfg = first_ok(at('AT+CGMI', 2));
		let i_model = first_ok(at('AT+CGMM', 2));
		let i_fw = first_ok(at('AT+CGMR', 2));
		let i_imei = substr(ident_token(at('AT+CGSN', 2), /^[0-9]{15,17}$/), 0, 15);
		let i_imsi = ident_token(at('AT+CIMI', 2), /^[0-9]{6,15}$/);
		let i_iccid = iccid_value(ident_token(at('AT+CCID', 2), /^[0-9A-Fa-f]{18,22}$/));
		let q = (s) => (s == '') ? null : s;
		IDENT_JSON = { ts: now(), mfg: q(i_mfg), model: q(i_model), fw: q(i_fw), imei: q(i_imei), imsi: q(i_imsi),
			iccid: q(i_iccid) };
		let text = sprintf('{"ts":%d,"mfg":%J,"model":%J,"fw":%J,"imei":%J,"imsi":%J,"iccid":%J}', IDENT_JSON.ts,
			IDENT_JSON.mfg, IDENT_JSON.model, IDENT_JSON.fw, IDENT_JSON.imei, IDENT_JSON.imsi, IDENT_JSON.iccid);
		if (i_imei != '' && i_imsi != '' && i_iccid != '') {
			publish(IDENT, text + '\n');
			unlink(IDENT_PART);
		}
		else {
			// an earlier complete identity (expired) stays what is shown and stays on flash; else this partial one
			if (stat(IDENT)?.size > 0 && ident_complete(IDENT)) {
				IDENT_JSON = parse(readfile(IDENT));
				text = replace(readfile(IDENT) ?? '', /\n+$/, '');
			}
			else if (i_imei == '' && i_imsi == '' && i_iccid == '') {
				IDENT_JSON = null;
				text = 'null';
			}
			publish(IDENT_PART, text + '\n');
		}
	}
	// The SIM's own number (MSISDN): AT+CNUM, else the IMS public identity. An empty answer is asked again on every
	// full round, a number found is kept in the runtime directory for this boot. Never in the 6 h identity cache
	// (flash) and never in the fast tier.
	let OWN = DIR + '/own-number';
	if (stat(OWN)?.size > 0) {
		let l = lines(readfile(OWN) ?? '')[0] ?? '';
		let m = match(l, /^([^ ]*) +(.*)$/);
		if (m) { i_msisdn_src = m[1]; i_msisdn = m[2]; }
	}
	if (i_msisdn == '') {
		i_msisdn = cnum_number(at('AT+CNUM', 2)); i_msisdn_src = 'sim';
		if (i_msisdn == '') {
			i_msisdn = ims_number(at('AT+SPPAURI?', 2)); i_msisdn_src = 'ims';
		}
		if (i_msisdn != '')
			publish(OWN, i_msisdn_src + ' ' + i_msisdn + '\n');
		else
			i_msisdn_src = '';
	}
}

// "no answer at all" is a modem/daemon problem, not "no signal"
if (CFUN + CEREG + CESQ + SP_LTE + SP_NR + COPS == '') {
	let err = jstr({ ts: now(), error: 'AT backend did not answer (radio off, modem restarting, or adapter unavailable)' }) + '\n';
	publish(SIGF, err);
	if (MODE == 'full')
		publish(CELL, err);
	release();
	exit(0);
}

let LTE = sp_lte(SP_LTE, SP_LTEPHY);
let NR = sp_nr(SP_NR);
// preferred signal source: NR (NSA/SA), then LTE, then the CESQ fallback
let SIG = CESQJ, SRC = 'cesq';
if (NR != null) { SIG = NR; SRC = 'nr'; }
else if (LTE != null) { SIG = LTE; SRC = 'lte'; }

// the fast tier: serving cell + registration only (both modes write it; the page overlays it on the full cache)
publish(SIGF, jstr({ ts: now(), cfun: CFUNN, reg: REG, reg5g: REG5, sig_src: SRC, sig: SIG, lte: LTE, nr: NR }) + '\n');

if (MODE == 'fast') {
	release();
	exit(0);
}

// the full tier: everything else the page needs only every few seconds; one neighbour list, NR first
let NEIGH = [ ...nr_neighbours(SP_NRNB), ...sp_ltenb(SP_LN) ];
if (!length(NEIGH))
	NEIGH = null;
let q = (s) => (s == '') ? null : s;
publish(CELL, jstr({ ts: now(), cfun: CFUNN, reg: REG, reg5g: REG5, operator: cops_fragment(COPS, OPN[0], OPN[1]),
	sig_src: SRC, sig: SIG, lte: LTE, nr: NR, qos: qos_fragment(QOS), neigh: NEIGH, ident: IDENT_JSON,
	msisdn: q(i_msisdn), msisdn_src: q(i_msisdn_src) }) + '\n');
release();
