# Forensics for the rpcd crash (2026-09-28): rpcd segfaulted while parsing a
# script reply during a lock apply, wiping every session (LuCI bounced to the
# login page). Every method's raw stdout is appended here, so the last entry
# at the moment of a crash is the input that killed the parser.
LASTLOG=$DIR/last-outputs.log
run_m() {  # run_m LABEL FUNCTION: the method's reply, logged
    local out
    out=$("$2" 2>/dev/null)
    printf '=== %s %s len=%s\n%s\n' "$(date '+%m-%d %H:%M:%S')" "$1" "${#out}" "$out" >> "$LASTLOG" 2>/dev/null
    tail -n 400 "$LASTLOG" > "$LASTLOG.t" 2>/dev/null && mv "$LASTLOG.t" "$LASTLOG"
    printf '%s\n' "$out"
}

case "${1:-}" in
list)
    do_list
    ;;
call)
    INPUT=$(cat 2>/dev/null)
    if input_too_large; then
        refuse 'Request too large'
        exit 0
    fi
    if [ "$DIR_OK" != 1 ]; then
        refuse 'The runtime directory is not safe; nothing was run'
        exit 0
    fi
    case ${2:-} in
        sysinfo)      run_m sysinfo      m_sysinfo ;;
        status)       run_m status       m_status ;;
        signal)       run_m signal       m_signal ;;
        act)          run_m act          m_act ;;
        at)           run_m at           m_at ;;
        at_history)   run_m at_history   m_at_history ;;
        lock_get)     run_m lock_get     m_lock_get ;;
        lock_set)     run_m lock_set     m_lock_set ;;
        sms_list)     run_m sms_list     m_sms_list ;;
        sms_show)     run_m sms_show     m_sms_show ;;
        sms_send)     run_m sms_send     m_sms_send ;;
        sms_delete)   run_m sms_delete   m_sms_delete ;;
        sms_sync)     run_m sms_sync     m_sms_sync ;;
        usb_get)      run_m usb_get      m_usb_get ;;
        usb_set)      run_m usb_set      m_usb_set ;;
        usb_net_list) run_m usb_net_list m_usb_net_list ;;
        usb_net_add)  run_m usb_net_add  m_usb_net_add ;;
        lang_get)     run_m lang_get     m_lang_get ;;
        lang_set)     run_m lang_set     m_lang_set ;;
        power_get)    run_m power_get    m_power_get ;;
        power_set)    run_m power_set    m_power_set ;;
        ttl_get)      run_m ttl_get      m_ttl_get ;;
        ttl_set)      run_m ttl_set      m_ttl_set ;;
        cpu_get)      run_m cpu_get      m_cpu_get ;;
        cpu_set)      run_m cpu_set      m_cpu_set ;;
        *)            refuse 'No such method' ;;
    esac
    ;;
*)
    echo "usage: $0 {list|call <method>}" >&2
    exit 2
    ;;
esac
