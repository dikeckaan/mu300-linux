#!/bin/sh
# Update the installed systems from a published release, on the device itself.
#   mu300-update check            what is installed, what is the newest release
#   mu300-update apply [OS...]    download, unpack and switch (default: every installed system), then the kernel and
#                                 the boot image
#   mu300-update boot             only the kernel and the boot image
#   mu300-update rollback [OS]    go back to the previous version kept as <os>.old
#   mu300-update rollback-boot    go back to the previous boot image
#   mu300-update kernel [5.4|6.18]  show, or change, the kernel (vendor 5.4 or mainline 6.18) and install it
#   mu300-update clean            delete the kept <os>.old copies
#
# How it works: the new filesystem is unpacked next to the old one as <os>.new on the Linux partition, your settings
# and the vendor files are carried over, and only then are the directories swapped (<os> -> <os>.old, <os>.new ->
# <os>). Renaming the directory a running system boots from is safe - the running processes keep the old one until
# the next boot - so an interrupted download or unpack can never leave a half-updated system behind.
#
# The kernel and the boot image are updated here too, from releases that carry the generic boot ramdisk segment (see
# boot_update). An mu300-update from before that installs the new system, which brings the new mu300-update: after
# a reboot (the running system is still the old one until then), "mu300-update apply" updates the boot image too.
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
REPO=${MU300_REPO:-dikeckaan/mu300-linux}
DISK=${MU300_DISK:-/mnt/mu300-disk}
CONF=/etc/mu300
VERSION_FILE=$CONF/image-version

say() { printf '\n==> %s\n' "$*"; }
die() { printf '\nERROR: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

fetch_stdout() {  # fetch_stdout URL
    if have curl; then curl -fsSL "$1"
    else wget -qO- "$1"; fi
}
fetch_file() {  # fetch_file URL OUT
    if have curl; then curl -fL --retry 3 -o "$2" "$1"
    else wget -O "$2" "$1"; fi
}

installed_version() { [ -r "$VERSION_FILE" ] && cat "$VERSION_FILE" || echo unknown; }
running_os() { [ -e /etc/openwrt_release ] && echo openwrt || echo ubuntu; }

# systems present on the Linux partition
installed_systems() {
    for os in ubuntu openwrt; do
        [ -d "$DISK/$os" ] && printf '%s ' "$os"
    done
}

latest_release() {
    fetch_stdout "https://api.github.com/repos/$REPO/releases/latest" \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1
}

mounted_disk() {
    [ -d "$DISK/ubuntu" ] || [ -d "$DISK/openwrt" ] || die "the Linux partition is not mounted at $DISK"
}

check() {
    mounted_disk
    latest=$(latest_release)
    [ -n "$latest" ] || die "could not reach GitHub (is the device online?)"
    printf 'installed image   %s\n' "$(installed_version)"
    printf 'newest release    %s\n' "$latest"
    printf 'systems on disk   %s\n' "$(installed_systems)"
    printf 'running now       %s\n' "$(running_os)"
    printf 'kernel            %s (boot image: %s; kernel choice %s)\n' "$(uname -r)" "$(cat "$BOOTDIR/installed.tag" 2>/dev/null || echo "from the installer")" "$(kernel_choice)"
    for os in $(installed_systems); do
        [ -d "$DISK/$os.old" ] && printf 'rollback available for %s (%s)\n' "$os" "$(cat "$DISK/$os.old/etc/mu300/image-version" 2>/dev/null || echo unknown)"
    done
    if [ "$(installed_version)" = "$latest" ] && [ "$(cat "$BOOTDIR/installed.tag" 2>/dev/null)" != "$latest" ]; then
        printf '\nThe system is up to date; the boot image may not be. Run: mu300-update apply\n'
    elif [ "$(installed_version)" = "$latest" ]; then
        printf '\nUp to date.\n'
    else
        printf '\nRun: mu300-update apply\n'
    fi
}

# everything that belongs to this device and must survive an update
keep_list() {
    case $1 in
        ubuntu) echo "etc/mu300 etc/ssh etc/hostname etc/localtime etc/timezone etc/fstab home root srv usr/local var/lib/bluetooth" ;;
        openwrt) echo "etc/config etc/mu300 etc/dropbear etc/rc.local root" ;;
    esac
}
# vendor files that the published images deliberately do not contain
vendor_list() {
    case $1 in
        ubuntu) echo "opt/mu300/android usr/lib/firmware" ;;
        # lib/modules: the release only ships modules for the kernel it was built with, so a hand-built set for
        # another kernel (the experimental 6.18 port) would be thrown away by an update without this
        openwrt) echo "opt/mu300/android lib/firmware lib/modules" ;;
    esac
}

# Accounts are settings too, and /etc/shadow is not in keep_list: an update used to leave the image's own password
# (the well-known ubuntu/ubuntu, or OpenWrt's empty root) and drop the users added on the device. Take the old
# entry of every account both systems have (password hashes, group memberships merged), and bring over the users
# and groups the old system added (ids 1000-59999).
ACCOUNTS_MARK=/etc/.mu300-accounts-from-image   # in the images; removed once the accounts are the device's own
merge_accounts() {  # merge_accounts OLD_ROOT NEW_ROOT   ("" is the running system)
    o=$1 n=$2
    [ -f "$o/etc/shadow" ] && [ -f "$n/etc/shadow" ] || return 0
    for f in passwd group shadow gshadow; do
        [ -f "$o/etc/$f" ] && [ -f "$n/etc/$f" ] || continue
        awk -F: -v OFS=: -v f="$f" -v op="$o/etc/passwd" -v og="$o/etc/group" '
            BEGIN {
                while ((getline l < op) > 0) { split(l, a, ":"); if (a[3] >= 1000 && a[3] < 60000) lu[a[1]] = 1 }
                while ((getline l < og) > 0) { split(l, a, ":"); if (a[3] >= 1000 && a[3] < 60000) lg[a[1]] = 1 }
            }
            NR == FNR { old[$1] = $0; next }
            {
                seen[$1] = 1
                if ((f == "shadow" || f == "gshadow") && ($1 in old)) { print old[$1]; next }
                if (f == "group" && ($1 in old)) {
                    split(old[$1], og4, ":"); m = $4; k = split(og4[4], om, ",")
                    for (i = 1; i <= k; i++)
                        if (om[i] != "" && index("," m ",", "," om[i] ",") == 0) m = (m == "" ? om[i] : m "," om[i])
                    $4 = m
                }
                print
            }
            END {
                for (x in old) if (!(x in seen)) {
                    if ((f == "passwd" || f == "shadow") && (x in lu)) print old[x]
                    if ((f == "group" || f == "gshadow") && (x in lg)) print old[x]
                }
            }' "$o/etc/$f" "$n/etc/$f" > "$n/etc/$f.mu300" || { rm -f "$n/etc/$f.mu300"; return 1; }
        # cat, not mv: keeps the file's owner and mode (shadow is root:shadow 0640)
        [ -s "$n/etc/$f.mu300" ] && cat "$n/etc/$f.mu300" > "$n/etc/$f"
        rm -f "$n/etc/$f.mu300"
    done
    rm -f "$n$ACCOUNTS_MARK"
}

# at boot (mu300-accounts): a system that an older mu300-update installed still has the image's accounts, and the
# system it replaced is still on the disk as <os>.old - take them from there before anyone can log in
accounts() {
    [ -e "$ACCOUNTS_MARK" ] || return 0
    os=$(running_os)
    if [ -f "$DISK/$os.old/etc/shadow" ]; then
        merge_accounts "$DISK/$os.old" "" && echo "accounts and passwords carried over from the previous $os"
    fi
    rm -f "$ACCOUNTS_MARK"
}

apply_one() {  # apply_one OS TAG
    os=$1 tag=$2
    old=$DISK/$os
    new=$DISK/$os.new
    [ -d "$old" ] || die "$os is not installed"
    tarball=mu300-$os-rootfs.tar.gz
    base=https://github.com/$REPO/releases/download/$tag
    tmp=$DISK/.mu300-update
    mkdir -p "$tmp"

    say "$os: downloading $tag"
    sums=$(fetch_stdout "$base/SHA256SUMS") || die "cannot download SHA256SUMS"
    want=$(printf '%s\n' "$sums" | awk -v f="$tarball" '$2 == f || $2 == "*" f {print $1}')
    [ -n "$want" ] || die "$tarball is not part of release $tag"
    free=$(df -k "$DISK" | awk 'NR==2 {print $4}')
    [ "$free" -gt 2000000 ] || die "less than 2 GB free on the Linux partition"
    fetch_file "$base/$tarball" "$tmp/$tarball" || die "download failed"
    have=$(sha256sum "$tmp/$tarball" | cut -d' ' -f1)
    [ "$have" = "$want" ] || { rm -f "$tmp/$tarball"; die "checksum mismatch, nothing was changed"; }

    say "$os: unpacking"
    rm -rf "$new"; mkdir -p "$new"
    tar -xzpf "$tmp/$tarball" -C "$new" || { rm -rf "$new" "$tmp/$tarball"; die "unpacking failed, nothing was changed"; }
    rm -f "$tmp/$tarball"
    [ -x "$new/sbin/init" ] || [ -L "$new/sbin/init" ] || [ -x "$new/bin/busybox" ] || { rm -rf "$new"; die "the unpacked system looks wrong, nothing was changed"; }

    say "$os: keeping your settings and the vendor files"
    # etc/mu300 is kept as a whole (hotspot.conf, vpn.conf, ...), but the version of the image belongs to the new
    # filesystem: copying the old directory over it would make every update report the version it replaced
    newver=$(cat "$new$VERSION_FILE" 2>/dev/null || true)
    for k in $(keep_list "$os"); do
        [ -e "$old/$k" ] || continue
        mkdir -p "$new/$(dirname "$k")"
        rm -rf "$new/$k"
        cp -a "$old/$k" "$new/$k"
    done
    merge_accounts "$old" "$new" || echo "$os: could not carry the accounts over; the image's default password applies" >&2
    if [ -n "$newver" ]; then
        mkdir -p "$new$CONF"
        printf '%s\n' "$newver" > "$new$VERSION_FILE"
    fi
    # firmware and the Android userspace come from this device, never from the release
    for v in $(vendor_list "$os"); do
        [ -d "$old/$v" ] || continue
        mkdir -p "$new/$v"
        cp -an "$old/$v/." "$new/$v/" 2>/dev/null || true
    done
    # services enabled by hand (the links point into the system, so test with -L)
    if [ "$os" = ubuntu ]; then
        for w in "$old"/etc/systemd/system/*.wants; do
            [ -d "$w" ] || continue
            t=${w##*/}
            for l in "$w"/*; do
                [ -L "$l" ] || continue
                u=${l##*/}
                [ -L "$new/etc/systemd/system/$t/$u" ] && continue
                [ -e "$new/etc/systemd/system/$u" ] || [ -e "$new/usr/lib/systemd/system/$u" ] || continue
                mkdir -p "$new/etc/systemd/system/$t"
                cp -a "$l" "$new/etc/systemd/system/$t/$u"
            done
        done
    else
        for l in "$old"/etc/rc.d/*; do
            [ -L "$l" ] || continue
            u=${l##*/}
            [ -L "$new/etc/rc.d/$u" ] && continue
            cp -a "$l" "$new/etc/rc.d/$u" 2>/dev/null || true
        done
    fi

    say "$os: switching over"
    sync
    rm -rf "$DISK/$os.old"
    mv "$old" "$DISK/$os.old" || die "could not move the old system aside"
    mv "$new" "$old" || { mv "$DISK/$os.old" "$old"; die "could not put the new system in place (old one restored)"; }
    sync
    printf '%s: updated %s -> %s\n' "$os" "$(cat "$DISK/$os.old$VERSION_FILE" 2>/dev/null || echo unknown)" "$(cat "$old$VERSION_FILE" 2>/dev/null || echo unknown)"
}

# ---- the kernel and the boot image ------------------------------------------------------------------------------
# The boot image in boot_b is the stock header and AVB tail of this device, the kernel, and a ramdisk that holds this
# device's own Android files next to the generic part (init, busybox, modules). The kernel unpacks concatenated
# ramdisk segments in turn and a later file replaces an earlier one, so an update keeps the device's ramdisk as it is
# and appends the release's generic segment (ramdisk-generic.lz4 in mu300-kernel.tar.gz): nothing has to be
# unpacked or compressed here, and nothing from Android is needed. The device's segment is kept in $BOOTDIR, so the
# image does not grow with every update; it is taken from boot_b again whenever boot_b was not written by us (a new
# install from a computer).
BOOTDIR=$DISK/boot
PERSIST_LOG=$((48 << 20))   # boot_b keeps the persistent init log from 48 MiB on (boot/build-boot-image.py)

# Which kernel this device runs: the vendor 5.4 (mu300-kernel.tar.gz) or mainline 6.18 (mu300-kernel-6.18.tar.gz).
# Kept on the Linux partition, so both systems and every update follow it - without it an update of a device on
# 6.18 installed the release's 5.4 kernel. "mu300-update kernel 6.18" changes it.
KERNEL_CHOICE=$BOOTDIR/kernel
kernel_choice() { c=$(cat "$KERNEL_CHOICE" 2>/dev/null); case $c in 6.18) echo 6.18 ;; *) echo 5.4 ;; esac; }
kernel_asset() { case $(kernel_choice) in 6.18) echo mu300-kernel-6.18.tar.gz ;; *) echo mu300-kernel.tar.gz ;; esac; }

part_dev() {  # part_dev NAME -> /dev/<block device of that partition>
    for u in /sys/class/block/*/uevent; do
        grep -qx "PARTNAME=$1" "$u" 2>/dev/null || continue
        d=${u%/uevent}
        echo "/dev/${d##*/}"
        return 0
    done
    return 1
}
u32() { od -An -tu4 -j "$2" -N4 "$1" | tr -d ' \n'; }                 # u32 FILE OFFSET (little endian)
be64() { printf '%d' "0x$(od -An -tx1 -j "$2" -N8 "$1" | tr -d ' \n')"; }  # be64 FILE OFFSET
bytes() {  # bytes VALUE COUNT le|be: the value as raw bytes
    v=$1 n=$2 i=0
    while [ "$i" -lt "$n" ]; do
        if [ "$3" = le ]; then s=$((8 * i)); else s=$((8 * (n - 1 - i))); fi
        printf "\\$(printf %o $(( (v >> s) & 255 )))"
        i=$((i + 1))
    done
}
poke() { dd of="$1" bs=1 seek="$2" conv=notrunc 2>/dev/null; }      # poke FILE OFFSET < bytes
fsize() { wc -c < "$1" | tr -d ' '; }
pad_page() { p=$(( (4096 - $(fsize "$1") % 4096) % 4096 )); [ "$p" = 0 ] || head -c "$p" /dev/zero >> "$1"; }
head_sha() { dd if="$1" bs=4096 count=$(( ($2 + 4095) / 4096 )) 2>/dev/null | head -c "$2" | sha256sum | cut -d' ' -f1; }

# write BODY (from offset 0), VBMETA right behind it and FOOTER into the last 64 bytes of boot_b, then read it back
write_boot() {  # write_boot DEV PSIZE BODY VBMETA FOOTER
    cat "$3" "$4" > "$3.all"
    dd if="$3.all" of="$1" bs=4096 conv=notrunc 2>/dev/null && sync || return 1
    dd if="$5" of="$1" bs=64 seek=$(($2 / 64 - 1)) conv=notrunc 2>/dev/null && sync || return 1
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
    [ "$(head_sha "$1" "$(fsize "$3.all")")" = "$(sha256sum < "$3.all" | cut -d' ' -f1)" ] || return 1
    [ "$(dd if="$1" bs=64 skip=$(($2 / 64 - 1)) count=1 2>/dev/null | sha256sum | cut -d' ' -f1)" = \
      "$(sha256sum < "$5" | cut -d' ' -f1)" ] || return 1
    rm -f "$3.all"
}

boot_update() {  # boot_update TAG   (MU300_KERNEL_BUNDLE=FILE uses a local mu300-kernel.tar.gz instead)
    tag=$1
    dev=$(part_dev boot_b) || { echo "boot: no boot_b partition found, boot image not updated" >&2; return 1; }
    psize=$(( $(cat "/sys/class/block/${dev##*/}/size") * 512 ))
    tmp=$DISK/.mu300-update/boot
    rm -rf "$tmp"; mkdir -p "$tmp" "$BOOTDIR"

    say "boot: kernel and boot image"
    bundle=${MU300_KERNEL_BUNDLE:-}
    if [ -z "$bundle" ]; then
        base=https://github.com/$REPO/releases/download/$tag
        sums=$(fetch_stdout "$base/SHA256SUMS") || { echo "boot: cannot download SHA256SUMS" >&2; return 1; }
        asset=$(kernel_asset)
        want=$(printf '%s\n' "$sums" | awk -v f="$asset" '$2 == f || $2 == "*" f {print $1}')
        [ -n "$want" ] || { echo "boot: release $tag has no $asset (kernel $(kernel_choice))" >&2; return 1; }
        bundle=$tmp/$asset
        fetch_file "$base/$asset" "$bundle" || { echo "boot: download failed" >&2; return 1; }
        [ "$(sha256sum "$bundle" | cut -d' ' -f1)" = "$want" ] || { echo "boot: checksum mismatch, nothing was changed" >&2; return 1; }
    fi
    [ -s "$bundle" ] || { echo "boot: $bundle not found" >&2; return 1; }
    tar -tzf "$bundle" > "$tmp/list" 2>/dev/null || { echo "boot: $bundle is not a readable tar.gz" >&2; return 1; }
    if ! grep -qx './ramdisk-generic.lz4' "$tmp/list"; then
        printf 'boot: release %s predates on-device boot updates; the boot image is unchanged\n' "$tag"
        rm -rf "$tmp"; return 0
    fi
    tar -xzf "$bundle" -C "$tmp" ./Image ./ramdisk-generic.lz4 || { echo "boot: unpacking $bundle failed" >&2; return 1; }
    [ -s "$tmp/Image" ] && [ -s "$tmp/ramdisk-generic.lz4" ] || { echo "boot: no kernel in the bundle" >&2; return 1; }
    # A kernel the systems were not built with (the mainline bundle) brings its modules along: they go into every
    # installed system before the boot image changes, next to the ones of the other kernel, which stay for a
    # switch back. Ubuntu keeps them under extra/ and indexes them; OpenWrt keeps them flat and loads by path.
    if grep -qx './kernel.release' "$tmp/list"; then
        tar -xzf "$bundle" -C "$tmp" ./kernel.release ./modules || { echo "boot: unpacking the modules failed" >&2; return 1; }
        krel=$(cat "$tmp/kernel.release")
        case $krel in ''|*/*|.*) echo "boot: bad kernel release '$krel' in the bundle" >&2; return 1 ;; esac
        for os in $(installed_systems); do
            case $os in ubuntu) d=$DISK/$os/lib/modules/$krel/extra ;; *) d=$DISK/$os/lib/modules/$krel ;; esac
            mkdir -p "$d" && cp "$tmp"/modules/*.ko "$d/" || { echo "boot: installing the modules into $os failed" >&2; return 1; }
            if [ "$os" = ubuntu ] && command -v depmod >/dev/null; then depmod -b "$DISK/$os" "$krel" 2>/dev/null || true; fi
        done
        printf 'boot: %s modules for %s installed into: %s\n' "$(ls "$tmp/modules" | wc -l | tr -d ' ')" "$krel" "$(installed_systems)"
    fi
    id=$(cat "$tmp/Image" "$tmp/ramdisk-generic.lz4" | sha256sum | cut -d' ' -f1)

    # the image in boot_b now: stock header page, kernel, ramdisk; AVB footer in the last 64 bytes
    dd if="$dev" of="$tmp/hdr" bs=4096 count=1 2>/dev/null
    dd if="$dev" of="$tmp/footer" bs=64 skip=$((psize / 64 - 1)) count=1 2>/dev/null
    [ "$(head -c 8 "$tmp/hdr")" = ANDROID! ] && [ "$(u32 "$tmp/hdr" 40)" = 4 ] ||
        { echo "boot: boot_b does not hold a boot image header v4, not touching it" >&2; return 1; }
    [ "$(head -c 4 "$tmp/footer")" = AVBf ] || { echo "boot: boot_b has no AVB footer, not touching it" >&2; return 1; }
    ksz=$(u32 "$tmp/hdr" 8); rsz=$(u32 "$tmp/hdr" 12)
    osize=$(be64 "$tmp/footer" 12); vbs=$(be64 "$tmp/footer" 28)
    dd if="$dev" of="$tmp/body" bs=4096 count=$((osize / 4096)) 2>/dev/null
    dd if="$dev" bs=4096 skip=$((osize / 4096)) count=$(( (vbs + 4095) / 4096 )) 2>/dev/null | head -c "$vbs" > "$tmp/vbmeta"
    cur=$(sha256sum < "$tmp/body" | cut -d' ' -f1)
    if [ "$cur" = "$(cat "$BOOTDIR/written.sha256" 2>/dev/null)" ] && [ "$id" = "$(cat "$BOOTDIR/installed.id" 2>/dev/null)" ]; then
        printf 'boot: already up to date (%s)\n' "$(cat "$BOOTDIR/installed.tag" 2>/dev/null || echo "$tag")"
        rm -rf "$tmp"; return 0
    fi
    if [ "$cur" != "$(cat "$BOOTDIR/written.sha256" 2>/dev/null)" ] || [ ! -s "$BOOTDIR/device-ramdisk.lz4" ]; then
        # boot_b comes from an installer: its whole ramdisk becomes the device segment (its generic files are
        # replaced by the ones appended below)
        roff=$((4096 + (ksz + 4095) / 4096 * 4096))
        head -c "$((roff + rsz))" "$tmp/body" | tail -c "$rsz" > "$BOOTDIR/device-ramdisk.lz4.new"
        [ "$(od -An -tx1 -N4 "$BOOTDIR/device-ramdisk.lz4.new" | tr -d ' \n')" = 02214c18 ] ||
            { rm -f "$BOOTDIR/device-ramdisk.lz4.new"; echo "boot: the ramdisk in boot_b is not LZ4 legacy, not touching it" >&2; return 1; }
        mv "$BOOTDIR/device-ramdisk.lz4.new" "$BOOTDIR/device-ramdisk.lz4"
    fi

    # new image: same header with the new sizes, kernel, device segment + generic segment, AVB tail
    nksz=$(fsize "$tmp/Image")
    nrsz=$(( $(fsize "$BOOTDIR/device-ramdisk.lz4") + $(fsize "$tmp/ramdisk-generic.lz4") ))
    cp "$tmp/hdr" "$tmp/new"
    bytes "$nksz" 4 le | poke "$tmp/new" 8
    bytes "$nrsz" 4 le | poke "$tmp/new" 12
    cat "$tmp/Image" >> "$tmp/new"; pad_page "$tmp/new"
    cat "$BOOTDIR/device-ramdisk.lz4" "$tmp/ramdisk-generic.lz4" >> "$tmp/new"; pad_page "$tmp/new"
    nosize=$(fsize "$tmp/new")
    [ $((nosize + vbs)) -le "$PERSIST_LOG" ] ||
        { echo "boot: the new image ($nosize bytes) would reach the persistent log area, not touching boot_b" >&2; return 1; }
    cp "$tmp/footer" "$tmp/newfooter"
    { bytes "$nosize" 8 be; bytes "$nosize" 8 be; bytes "$vbs" 8 be; } | poke "$tmp/newfooter" 12

    # keep the current image for rollback-boot, then write
    cp "$tmp/body" "$BOOTDIR/prev.body"; cp "$tmp/vbmeta" "$BOOTDIR/prev.vbmeta"; cp "$tmp/footer" "$BOOTDIR/prev.footer"
    cat "$BOOTDIR/installed.tag" > "$BOOTDIR/prev.tag" 2>/dev/null || echo installer > "$BOOTDIR/prev.tag"
    cat "$BOOTDIR/installed.kernel" > "$BOOTDIR/prev.kernel" 2>/dev/null || echo 5.4 > "$BOOTDIR/prev.kernel"
    sync
    if ! write_boot "$dev" "$psize" "$tmp/new" "$tmp/vbmeta" "$tmp/newfooter"; then
        echo "boot: writing boot_b failed verification; restoring the previous image" >&2
        write_boot "$dev" "$psize" "$BOOTDIR/prev.body" "$BOOTDIR/prev.vbmeta" "$BOOTDIR/prev.footer" ||
            echo "boot: RESTORE FAILED - do not reboot into Linux; reinstall with ./install.sh from a computer" >&2
        return 1
    fi
    sha256sum < "$tmp/new" | cut -d' ' -f1 > "$BOOTDIR/written.sha256"
    echo "$id" > "$BOOTDIR/installed.id"
    echo "$tag" > "$BOOTDIR/installed.tag"
    kernel_choice > "$BOOTDIR/installed.kernel"
    sync
    rm -rf "$tmp"
    printf 'boot: updated to %s (kernel %s bytes, ramdisk %s bytes). If it does not start, the device falls back\n' "$tag" "$nksz" "$nrsz"
    printf '      to Android by itself; mu300-update rollback-boot restores the previous image.\n'
    BOOT_CHANGED=1
}

kernel_cmd() {  # kernel [5.4|6.18]: show or change the kernel, and install it
    mounted_disk
    case ${1:-} in
        '') printf 'kernel: %s (running %s)\n' "$(kernel_choice)" "$(uname -r)"; return 0 ;;
        5.4|6.18) ;;
        *) die "usage: mu300-update kernel [5.4|6.18]" ;;
    esac
    mkdir -p "$BOOTDIR"
    old=$(kernel_choice)
    echo "$1" > "$KERNEL_CHOICE"
    t=${MU300_RELEASE:-$(latest_release)}
    [ -n "$t" ] || { echo "$old" > "$KERNEL_CHOICE"; die "could not reach GitHub (is the device online?)"; }
    if ! boot_update "$t"; then
        echo "$old" > "$KERNEL_CHOICE"
        die "the $1 kernel was not installed; staying on $old"
    fi
    sync
    printf '\nkernel %s selected. Reboot to start it (mu300-update rollback-boot goes back).\n' "$1"
}

rollback_boot() {
    mounted_disk
    [ -s "$BOOTDIR/prev.body" ] || die "no previous boot image kept"
    dev=$(part_dev boot_b) || die "no boot_b partition found"
    psize=$(( $(cat "/sys/class/block/${dev##*/}/size") * 512 ))
    write_boot "$dev" "$psize" "$BOOTDIR/prev.body" "$BOOTDIR/prev.vbmeta" "$BOOTDIR/prev.footer" ||
        die "writing the previous boot image failed verification"
    sha256sum < "$BOOTDIR/prev.body" | cut -d' ' -f1 > "$BOOTDIR/written.sha256"
    rm -f "$BOOTDIR/installed.id"
    cat "$BOOTDIR/prev.tag" > "$BOOTDIR/installed.tag" 2>/dev/null
    # the image that is back belongs to a kernel choice too: without this the next update would reinstall the
    # kernel just rolled back from
    if [ -s "$BOOTDIR/prev.kernel" ]; then
        cat "$BOOTDIR/prev.kernel" > "$KERNEL_CHOICE"
        cat "$BOOTDIR/prev.kernel" > "$BOOTDIR/installed.kernel"
    fi
    sync
    printf 'boot: previous boot image (%s) restored. Reboot to start it.\n' "$(cat "$BOOTDIR/prev.tag" 2>/dev/null || echo unknown)"
}

apply() {
    mounted_disk
    tag=${MU300_RELEASE:-$(latest_release)}
    [ -n "$tag" ] || die "could not reach GitHub (is the device online?)"
    list=$*
    [ -n "$list" ] || list=$(installed_systems)
    BOOT_CHANGED=
    SYSTEM_CHANGED=
    for os in $list; do
        case $os in ubuntu|openwrt) ;; *) die "unknown system '$os'" ;; esac
        # already there: an older mu300-update installed this release's system, and this run is for the boot image
        if [ "$(cat "$DISK/$os$VERSION_FILE" 2>/dev/null)" = "$tag" ] && [ -z "${MU300_FORCE:-}" ]; then
            printf '%s: already %s\n' "$os" "$tag"
            continue
        fi
        apply_one "$os" "$tag"
        SYSTEM_CHANGED=1
    done
    # the kernel goes with the modules of the systems just installed, so it follows them
    boot_ok=1
    boot_update "$tag" || { boot_ok=; printf '\nThe boot image was not updated (see above)%s.\n' "${SYSTEM_CHANGED:+; the systems were}"; }
    if [ -z "$SYSTEM_CHANGED$BOOT_CHANGED" ]; then
        [ -n "$boot_ok" ] || return 1
        printf '\nNothing to do.\n'
        return 0
    fi
    if [ -z "$SYSTEM_CHANGED" ]; then
        printf '\nReboot to start the new kernel. The previous boot image is kept: mu300-update rollback-boot\n'
        return 0
    fi
    case " $list " in
        *" $(running_os) "*) printf '\nReboot to start the updated %s. The previous version is kept: mu300-update rollback\n' "$(running_os)" ;;
        *) printf '\nDone. The updated system is used the next time you switch to it.\n' ;;
    esac
}

rollback() {
    mounted_disk
    list=$*
    [ -n "$list" ] || list=$(installed_systems)
    done_any=
    for os in $list; do
        [ -d "$DISK/$os.old" ] || { printf '%s: no previous version kept\n' "$os"; continue; }
        sync
        rm -rf "$DISK/$os.broken"
        mv "$DISK/$os" "$DISK/$os.broken" || die "$os: could not move the current system aside"
        mv "$DISK/$os.old" "$DISK/$os" || { mv "$DISK/$os.broken" "$DISK/$os"; die "$os: rollback failed (current system restored)"; }
        rm -rf "$DISK/$os.broken"
        sync
        printf '%s: rolled back to %s\n' "$os" "$(cat "$DISK/$os$VERSION_FILE" 2>/dev/null || echo unknown)"
        done_any=1
    done
    [ -n "$done_any" ] && printf '\nReboot to start it.\n'
}

clean() {
    mounted_disk
    for os in ubuntu openwrt; do
        [ -d "$DISK/$os.old" ] || continue
        rm -rf "$DISK/$os.old"
        printf '%s: previous version deleted\n' "$os"
    done
    sync
    df -h "$DISK" | tail -1
}

[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
case ${1:-check} in
    check) check ;;
    apply) shift; apply "$@" ;;
    boot) mounted_disk; t=${MU300_RELEASE:-$(latest_release)}; [ -n "$t" ] || die "could not reach GitHub (is the device online?)"
          boot_update "$t" || exit 1; [ -n "${BOOT_CHANGED:-}" ] && printf '\nReboot to start the new kernel.\n' ;;
    rollback) shift; rollback "$@" ;;
    rollback-boot) rollback_boot ;;
    kernel) shift; kernel_cmd "$@" ;;
    accounts) accounts ;;
    clean) clean ;;
    -h|--help|help) sed -n '2,11s/^# \{0,1\}//p' "$0" ;;
    *) echo "usage: mu300-update check|apply [os...]|boot|kernel [5.4|6.18]|rollback [os]|rollback-boot|clean" >&2; exit 2 ;;
esac
