#!/bin/sh
# Send an AT command through mu300-atd (which owns the modem's AT channel; see that script for why).
#   mu300-at "AT+CSQ"            print the reply
#   mu300-at -t 20 "AT+SFUN=4"   wait longer than the default 6 s
# Falls back to opening the tty directly when the daemon is not running - that works once, and then the channel
# needs a modem restart, so the daemon is strongly preferred.
# Needs a shell with "read -t" (bash or busybox ash): dash has no such option, and this tty ignores the termios
# timer and blocks in the driver instead - see mu300-atd for the whole story.
set -u
# OpenWrt keeps the applets this needs (timeout) in the static busybox next to us
export PATH="$PATH:/opt/mu300/bin:/opt/mu300/busybox-bin:/usr/sbin:/sbin"
if [ -n "$(read -t 1 _probe </dev/null 2>&1)" ]; then
    for sh in /bin/bash /usr/bin/bash /bin/busybox; do
        [ -x "$sh" ] || continue
        case $sh in */busybox) exec "$sh" ash "$0" "$@" ;; *) exec "$sh" "$0" "$@" ;; esac
    done
    echo "mu300-at: need bash or busybox ash (this shell has no 'read -t')" >&2; exit 1
fi
DIR=${MU300_AT_DIR:-/run/mu300-at}
DEV=${MU300_AT_DEV:-/dev/stty_nr1}
CR=$(printf '\r')
T=6
[ "${1:-}" = -t ] && { T=$2; shift 2; }
cmd=${1:-}
[ -n "$cmd" ] || { echo "usage: mu300-at [-t SECONDS] \"AT+COMMAND\"" >&2; exit 2; }

if [ -p "$DIR/cmd" ]; then
    # one client at a time: the daemon serves a single command per round. The wait has to cover the slowest
    # command somebody else may be running (AT+SFUN=4 takes ~20 s), not just this one.
    # This is the mutex between clients only. The daemon's own "I hold the channel" directory is $DIR/owner:
    # the two were the same path once, and since the daemon never lets go, every client then waited out the
    # full 90 s and gave up on an idle modem (see mu300-atd).
    lock=$DIR/lock
    wait=${MU300_AT_LOCK_WAIT:-90}
    n=0
    while ! mkdir "$lock" 2>/dev/null; do
        # a client killed with SIGKILL cannot clean up after itself; take the lock over when its owner is gone
        owner=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then rm -rf "$lock"; continue; fi
        # a daemon from before the split left its ownership directory here, and it will never release it
        if [ -n "$owner" ] && tr '\0' ' ' < "/proc/$owner/cmdline" 2>/dev/null | grep -q mu300-atd; then
            rm -rf "$lock"; continue
        fi
        n=$((n + 1)); [ "$n" -gt $((wait * 10)) ] && { echo "mu300-at: busy" >&2; exit 1; }
        sleep 0.1 2>/dev/null || /opt/mu300/bin/busybox sleep 0.1 2>/dev/null || sleep 1
    done
    echo $$ > "$lock/pid" 2>/dev/null || true
    trap 'rm -rf "$lock" 2>/dev/null' EXIT INT TERM
    # The answer comes back in a file of our own, not through a fifo: a fifo needs both ends at the same time,
    # so a client that gave up waiting used to leave the daemon (or a leftover writer) blocked for ever.
    answer=$DIR/answer.$$
    rm -f "$answer" "$answer.part"
    trap 'rm -rf "$lock" "$answer" "$answer.part" 2>/dev/null' EXIT INT TERM
    # write to the daemon's command fifo. The old `timeout N sh -c 'printf ...'` wrapper
    # cost 200+ ms per command (two forks + timer setup on this SoC, visible only when
    # the whole thing ran inside a CGI where every fork's pipe-close is waited for by
    # uhttpd). The daemon is always reading this fifo, so the write completes in
    # microseconds; if the daemon is dead the client hits its own answer-file timeout
    # below, which is the same outcome the timeout wrapper was trying to avoid.
    # Open the FIFO read-write.  A write-only open blocks until a reader opens
    # the *same inode*.  If procd replaces the daemon between the path lookup and
    # that open, the client and the new daemon wait forever on two different,
    # unlinked FIFOs while this client keeps the global command lock.  O_RDWR
    # never blocks; with no daemon the answer timeout below releases the lock.
    exec 9<> "$DIR/cmd" 2>/dev/null || {
        echo "mu300-at: the daemon is not reading commands" >&2; exit 1; }
    printf '%s %s %s\n' "$T" "$answer" "$cmd" >&9 || {
        exec 9>&-; echo "mu300-at: the daemon is not reading commands" >&2; exit 1; }
    exec 9>&-
    n=0
    # fast poll: the daemon typically writes the answer in ~20 ms, so a 1 s sleep
    # here adds a full second to every AT round trip. The system /bin/sleep (busybox
    # applet) rejects fractional arguments on this image ("invalid number"), which
    # quietly sank the chain below into `sleep 1` - every command cost a flat
    # second (measured: 30 commands in 30.6 s). The static busybox next to us
    # accepts fractions; use it when present.
    zz=$([ -x /opt/mu300/bin/busybox ] && echo /opt/mu300/bin/busybox || echo sleep)
    while [ ! -e "$answer" ]; do
        n=$((n + 1))
        [ "$n" -gt $(( (T + 1) * 100 )) ] && { echo "mu300-at: no answer from the daemon" >&2; exit 1; }
        "$zz" sleep 0.01 2>/dev/null || "$zz" sleep 0.1 2>/dev/null || sleep 1
    done
    # atd always creates the answer file, including for a timeout. An empty
    # file is therefore not success: callers such as atwatch use the exit code
    # to distinguish a responding channel from a silent one.
    # A timed-out daemon can leave CR/LF or an echoed fragment in the answer
    # file. Success requires a real final result code; otherwise callers must
    # be able to fail over instead of accepting a blank/partial frame.
    grep -aEq '^(OK|ERROR|\+CME ERROR|\+CMS ERROR|CONNECT|NO CARRIER)' "$answer" 2>/dev/null || {
        echo "mu300-at: modem returned no final response" >&2
        exit 1
    }
    cat "$answer"
    exit 0
fi

# No command fifo is not the same as no daemon: remove $DIR under a running mu300-atd and its descriptor is still
# the one the modem talks to. Opening the device here would make a second reader on a channel that hands each
# line to exactly one of them, so refuse instead - and the direct path below is a one-shot in any case, because
# closing this channel while the modem is running leaves it silent until a reboot (FINDINGS 13b).
owner=$(cat "$DIR/owner/pid" 2>/dev/null || true)
if [ -n "$owner" ] && [ -d "/proc/$owner" ] &&
   tr '\0' ' ' < "/proc/$owner/cmdline" 2>/dev/null | grep -qE 'mu300-atd|mobile-data'; then
    echo "mu300-at: pid $owner holds $DEV and its command fifo is gone; restart mu300-atd" >&2
    exit 1
fi

echo "mu300-at: daemon not running, using $DEV directly (this can wedge the channel)" >&2
[ -c "$DEV" ] || { echo "mu300-at: no $DEV" >&2; exit 1; }
exec 3<>"$DEV"
stty raw -echo <&3 2>/dev/null || true
while :; do j=; IFS= read -r -t 1 j <&3 || break; done
printf '%s\r' "$cmd" >&3
end=$(( $(date +%s) + T ))
while [ "$(date +%s)" -lt "$end" ]; do
    l=
    IFS= read -r -t 2 l <&3 || continue
    l=${l%"$CR"}; [ -n "$l" ] || continue
    echo "$l"
    case $l in OK|ERROR|+CME\ ERROR*|+CMS\ ERROR*|CONNECT*|NO\ CARRIER) break ;; esac
done
exec 3>&-
