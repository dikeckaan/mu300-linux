#!/bin/sh
# Select one SIM for the whole boot. Reopening SIPC channels is not a hot switch.
# OpenWrt: network.wan.sim_slot; other systems: /etc/mu300/sim-slot.
# No modem, SIM-profile or identity writes are made here.
set -eu
root=${MU300_SIM_ROOT:-}
state=$root/run/mu300/sim-slot
conf=$root/etc/mu300/sim-slot
device_cmd=${MU300_DEVICE_CMD:-/opt/mu300/bin/mu300-device}
device_name() {
    [ -x "$device_cmd" ] || return 0
    "$device_cmd" 2>/dev/null || true
}
ensure_f50() {
    local device
    device=$(device_name)
    [ -z "$device" ] || [ "$device" = f50 ] || {
        echo "mu300-sim: SIM selection is supported on F50 only (detected $device)" >&2
        return 1
    }
}
valid() { case "$1" in 0|1) return 0 ;; *) echo 'SIM slot must be 0 (external) or 1 (internal)' >&2; return 1 ;; esac; }
configured() {
    local slot
    if command -v uci >/dev/null 2>&1; then
        slot=$(uci -q get network.wan.sim_slot || true)
    else
        slot=$(cat "$conf" 2>/dev/null || true)
    fi
    slot=${slot:-0}
    valid "$slot" || return 1
    printf '%s\n' "$slot"
}
active() {
    local slot tmp
    if [ ! -e "$state" ]; then
        slot=$(configured) || return 1
        mkdir -p "${state%/*}"
        # Publish once, atomically. Concurrent daemon starts keep the same boot slot.
        tmp=$(mktemp "${state}.XXXXXX") || return 1
        printf '%s\n' "$slot" > "$tmp"
        ln "$tmp" "$state" 2>/dev/null || { [ -f "$state" ] || { rm -f "$tmp"; return 1; }; }
        rm -f "$tmp"
    fi
    slot=$(cat "$state")
    valid "$slot" || return 1
    printf '%s\n' "$slot"
}
case ${1:-status} in
    active) active ;;
    configured) configured ;;
    status)
        ensure_f50 || exit 1
        old=$(active) || exit 1
        next=$(configured) || exit 1
        if [ "${2:-}" = --json ]; then
            printf '{"ok":1,"active":%s,"default":%s,"hot":0,"available":0,"result":"reboot_required"}\n' "$((old + 1))" "$((next + 1))"
        else
            printf 'active slot: %s\nnext boot slot: %s\n' "$old" "$next"
        fi
        ;;
    select|default)
        ensure_f50 || exit 1
        if [ "$1" = default ]; then
            case ${2:-} in 1) next=0 ;; 2) next=1 ;; *) valid invalid; exit 2 ;; esac
        else
            case ${2:-} in external|0) next=0 ;; internal|1) next=1 ;; *) valid invalid; exit 2 ;; esac
        fi
        # Pin the current slot before changing the next-boot setting.
        old=$(active) || exit 1
        if command -v uci >/dev/null 2>&1; then
            uci set "network.wan.sim_slot=$next"
            uci commit network
        else
            mkdir -p "${conf%/*}"
            tmp=$(mktemp "${conf}.XXXXXX")
            printf '%s\n' "$next" > "$tmp"
            mv "$tmp" "$conf"
        fi
        echo "SIM slot $next saved. Active slot remains $old until reboot."
        ;;
    hot|switch)
        echo 'mu300-sim: live SIM switching is not supported on F50; select a slot and reboot' >&2
        exit 1
        ;;
    *) echo 'usage: mu300-sim status [--json]|active|configured|select external|internal|default 1|2' >&2; exit 2 ;;
esac
