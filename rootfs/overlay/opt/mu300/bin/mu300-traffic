#!/bin/sh
# mu300-traffic: how much mobile data was used, per day, per billing cycle and per billing year, with an optional
# monthly cap (Ubuntu and OpenWrt; the control panel's Data usage page shows the same).
#   mu300-traffic                 today, this billing cycle, the cap, the daily quota and the yearly plan
#   mu300-traffic days [N]        the last N days with traffic (default 31)
#   mu300-traffic cycles [N]      the last N billing cycles (default 12)
#   mu300-traffic json            all of it as one JSON object (the panel)
#   mu300-traffic set KEY VALUE   reset-day 1-31     the day a billing cycle starts (31: the month's last day)
#                                 cap SIZE|off       the monthly cap, e.g. 50G (binary units: 1G = 1024M)
#                                 warn 1-100         warn at this percentage of the cap (default 90); the yearly
#                                                    cap warns at the same percentage
#                                 cut on|off         at the cap, turn mobile data off until the next cycle
#                                 daily SIZE|off     a daily quota, e.g. 2G (warned at the same percentage)
#                                 daily-cut on|off   at the daily quota, turn mobile data off until midnight
#                                 count total|rx|tx  what the cap, the quota and the yearly cap count: both ways
#                                                    (default), downloads only or uploads only
#                                 plan NAME          the plan's name, shown with the count ('' for none)
#                                 device IFACE|auto  the interface counted (default auto: the one mobile data
#                                                    uses now, e.g. sipa_eth8 with the internal SIM)
#                                 yearly SIZE|off    the yearly cap, e.g. 500G (the same warning percentage; off by
#                                                    default)
#                                 yearly-start MM-DD the day a billing year starts (default 01-01; 02-29 is 02-28 in
#                                                    a common year)
#                                 yearly-cut on|off  at the yearly cap, turn mobile data off until the next year
#                                 used-remaining SIZE  what the operator shows as left this cycle: the count is
#                                                    corrected to cap - remaining
#                                 yearly-used-remaining SIZE  the same for the billing year (yearly cap - remaining)
#   mu300-traffic used SIZE       what the operator says this cycle has used so far (the count is corrected)
#   mu300-traffic yearly-used SIZE  what the operator says this year has used so far (the yearly count is corrected)
#   mu300-traffic clear --yes     forget every count; counting goes on from now
#   mu300-traffic save            write the count to the disk now
#   mu300-traffic run             the service (mu300-traffic.service, init.d/mu300-traffic)
#   mu300-traffic clock-synced    the clock is right now (OpenWrt's NTP hotplug says so)
#
# What is counted: the bytes of the cellular interface (DEVICE=auto: the one mobile data uses now - netifd's WAN
# device on OpenWrt, else the sipa_eth that is up - sipa_eth0 with the external SIM, sipa_eth8 with the internal
# one), both ways: what the operator sees, a VPN's own
# overhead included. The kernel's counters are read every INTERVAL seconds (60); the modem is never asked.
# Every byte counts once:
#   * The counters start at 0 when the interface is made (each boot, a driver reload): a new boot or ifindex, or a
#     counter lower than the last reading, means new counters, and all of them are new bytes.
#   * The very first reading (and one after the counted interface changed) is only a base: what the interface
#     carried before cannot be put on a day honestly.
#   * The bytes of one interval go to the local days it covers, split at midnight in proportion to the time; the
#     interval is measured with the uptime, so a clock jump does not stretch or squeeze it.
#   * Until the clock is known to be right (there is no RTC: after a boot it is whatever sysfixtime or the last
#     shutdown left), bytes wait, by uptime, in "pending"; once NTP has set it they go to the days they belong to.
#     Pending bytes count towards the cycle (and the cap) at once. After six hours without NTP the clock is taken
#     as it is (CLOCK=trust in the configuration: at once).
# Flash wear: the live count is in /run/mu300/traffic (RAM). The disk copy is written every CHECKPOINT seconds
# (1800), after CHECKPOINT_BYTES (1 GiB) more traffic but not within 5 minutes of the last one, at a clean shutdown
# and after every change made here - always a new file renamed over the old one. A power cut loses what was counted
# since the last write, never more; nothing is ever counted twice.
# The count and its settings are on the Linux disk (.mu300/traffic), so OpenWrt, OpenWrt with the panel and Ubuntu
# share one count; a system without that directory keeps it in /etc/mu300/traffic.
# Cap: at WARN percent of it a warning (the panel, the log); with cut on, mobile data goes off at the cap (OpenWrt:
# ifdown wan; Ubuntu: mu300-mobile-data.service stops). It is cut once per cycle, and again after a reboot; whoever
# turns mobile data back on in the same boot keeps it on. It comes back on by itself when the next cycle starts,
# the cap is raised or cut is turned off - if this tool was what turned it off.
# Daily quota (none by default): the same for one local day, with its own daily-cut (off by default); a cut by it
# ends at midnight. Data comes back on only when neither the cap nor the quota still holds it off. Pending bytes count
# towards today at once. COUNT (rx or tx) makes the cap, the quota and "used" count one direction only; the days and
# cycles still show both. A "used" correction belongs to the count mode it was made in: another mode drops it.
# Billing year (off by default): the same as the cap for one year, which starts on YEARLY-START (MM-DD, 01-01 by
# default) and rolls over by itself at its next anniversary - a correction of the year (yearly-used) and the year's
# own cut (yearly-cut, off by default) end with it. Its count is that of the days in the year, so a cap set in the
# middle of a year starts from the year's real usage; the yearly ledger lines are written only while a yearly cap is
# set. A remaining shown by the operator corrects a count the other way (used-remaining, yearly-used-remaining).
# (MU300_SYSROOT, MU300_DISK, MU300_TRAFFIC_STORE, MU300_TRAFFIC_RUN, MU300_TRAFFIC_NOW and MU300_TRAFFIC_TZOFF are
# for tests/: a fake /, another disk or store, a fixed clock and UTC offset in seconds.)
export PATH="$PATH:/opt/mu300/bin:/usr/sbin:/sbin"
R=${MU300_SYSROOT:-}
RUN=${MU300_TRAFFIC_RUN:-$R/run/mu300/traffic}
store_dir() {
    for d in "${MU300_DISK:-$R/mnt/mu300-disk}" "$R"; do
        [ -d "$d/.mu300" ] && { printf '%s/.mu300/traffic' "$d"; return; }
    done
    printf '%s/etc/mu300/traffic' "$R"
}
STORE=${MU300_TRAFFIC_STORE:-$(store_dir)}
CONF=$STORE/conf
DISK=$STORE/ledger
LIVE=$RUN/ledger
SUMMARY=$RUN/summary
LOCK=$RUN/lock
SYNCED=$R/run/mu300/clock-synced

die() { echo "mu300-traffic: $*" >&2; exit 1; }

# ------------------------------------------------------------------ settings
# conf KEY DEFAULT ERE: the setting, if it is one line matching ^ERE$ (the file is read, never sourced)
conf() {
    v=$(sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -n1)
    if printf '%s\n' "$v" | LC_ALL=C grep -Eqx -- "$3"; then printf '%s\n' "$v"; else printf '%s\n' "$2"; fi
}
# a plan's name: one line, no control character, at most 96 bytes (UTF-8 is fine)
PLAN_ERE='[^[:cntrl:]]{0,96}'
# yearly_start_ok MM-DD: a day a year really has (02-29 counts: a leap year has it)
yearly_start_ok() {
    _m=${1%-*} _d=${1#*-}
    case $_d in 0[1-9]|[12][0-9]|3[01]) ;; *) return 1 ;; esac
    case $_m in
        01|03|05|07|08|10|12) _max=31 ;;
        04|06|09|11) _max=30 ;;
        02) _max=29 ;;
        *) return 1 ;;
    esac
    [ "$_d" -le "$_max" ]
}
load_conf() {
    RESET_DAY=$(conf RESET_DAY 1 '[1-9]|[12][0-9]|3[01]')
    CAP=$(conf CAP 0 '[0-9]{1,16}')
    WARN=$(conf WARN 90 '[1-9]|[1-9][0-9]|100')
    CUT=$(conf CUT 0 '[01]')
    DAILY=$(conf DAILY 0 '[0-9]{1,16}')
    DAILY_CUT=$(conf DAILY_CUT 0 '[01]')
    COUNT=$(conf COUNT total 'total|rx|tx')
    PLAN=$(conf PLAN '' "$PLAN_ERE")
    DEVICE=$(conf DEVICE auto 'auto|[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}')
    # sipa_eth0 was the default before auto, and every saved setting wrote it into the file: it means auto (issue
    # #369: with the internal SIM the bearer is sipa_eth8, and sipa_eth0 counted nothing)
    [ "$DEVICE" != sipa_eth0 ] || DEVICE=auto
    YEARLY=$(conf YEARLY 0 '[0-9]{1,16}')
    YEARLY_START=$(conf YEARLY_START 01-01 '[0-9]{2}-[0-9]{2}')
    yearly_start_ok "$YEARLY_START" || YEARLY_START=01-01
    YEARLY_CUT=$(conf YEARLY_CUT 0 '[01]')
    INTERVAL=$(conf INTERVAL 60 '[1-9][0-9]{1,3}')
    CHECKPOINT=$(conf CHECKPOINT 1800 '[1-9][0-9]{2,5}')
    CHECKPOINT_BYTES=$(conf CHECKPOINT_BYTES 1073741824 '[1-9][0-9]{5,15}')
    CLOCK=$(conf CLOCK auto 'auto|trust')
}
# write_conf KEY VALUE: that setting changed, the others kept (a new file renamed over the old one)
write_conf() {
    mkdir -p "$STORE" || die "cannot create $STORE"
    load_conf
    eval "$1=\$2"
    printf 'RESET_DAY=%s\nCAP=%s\nWARN=%s\nCUT=%s\nDAILY=%s\nDAILY_CUT=%s\nCOUNT=%s\nPLAN=%s\nDEVICE=%s\nYEARLY=%s\nYEARLY_START=%s\nYEARLY_CUT=%s\nINTERVAL=%s\nCHECKPOINT=%s\nCHECKPOINT_BYTES=%s\nCLOCK=%s\n' \
        "$RESET_DAY" "$CAP" "$WARN" "$CUT" "$DAILY" "$DAILY_CUT" "$COUNT" "$PLAN" "$DEVICE" "$YEARLY" "$YEARLY_START" \
        "$YEARLY_CUT" "$INTERVAL" "$CHECKPOINT" "$CHECKPOINT_BYTES" "$CLOCK" > "$CONF.new" && mv "$CONF.new" "$CONF" ||
        die "cannot write $CONF"
}
# size_bytes SIZE: 50G, 1.5T, 300M, 1024 (bytes) -> bytes; binary units, as the panel shows them
size_bytes() {
    printf '%s\n' "$1" | awk '{ s = toupper($0); sub(/I?B$/, "", s)
        if (s !~ /^[0-9]+(\.[0-9]+)?[KMGT]?$/) exit 1
        u = substr(s, length(s)); f = 1
        if (u == "K") f = 1024; else if (u == "M") f = 1048576; else if (u == "G") f = 1073741824
        else if (u == "T") f = 1099511627776
        if (u ~ /[KMGT]/) s = substr(s, 1, length(s) - 1)
        b = s * f; if (b >= 1e16) exit 1
        printf "%.0f\n", b }'
}

# ------------------------------------------------------------------ readings
now() { echo "${MU300_TRAFFIC_NOW:-$(date +%s)}"; }
# the UTC offset in seconds of the local time now (+0300 -> 10800); days are local days
tzoff() {
    [ -n "${MU300_TRAFFIC_TZOFF:-}" ] && { echo "$MU300_TRAFFIC_TZOFF"; return; }
    date +%z | awk '{ s = substr($0, 1, 1) == "-" ? -1 : 1; print s * (substr($0, 2, 2) * 3600 + substr($0, 4, 2) * 60) }'
}
# clock: NOW and OFF (as now and tzoff) from one date, the offset worked out by the shell (FINDINGS 235: the service's
# round used to run date twice and awk for this)
clock() {
    NOW=${MU300_TRAFFIC_NOW:-} OFF=${MU300_TRAFFIC_TZOFF:-}
    [ -n "$NOW" ] && [ -n "$OFF" ] && return 0
    set -- $(date '+%s %z')
    [ -n "$NOW" ] || NOW=${1:-0}
    [ -n "$OFF" ] && return 0
    case ${2:-} in
        [+-][0-9][0-9][0-9][0-9])
            _h=${2#?}; _m=${_h#??}; _h=${_h%??}
            OFF=$(( ${_h#0} * 3600 + ${_m#0} * 60 ))
            case $2 in -*) OFF=$((-OFF)) ;; esac ;;
        *) OFF=$(tzoff) ;;
    esac
}
uptime_s() { { read -r u _ < "$R/proc/uptime"; } 2>/dev/null; echo "${u%%.*}"; }
uptime_v() { u=; { read -r u _ < "$R/proc/uptime"; } 2>/dev/null; UP=${u%%.*}; }   # the same, into UP
# counters: BOOT IDX RX TX of the counted interface (BOOT alone without it)
counters() {
    BOOT= IDX= RX= TX=
    { read -r BOOT < "$R/proc/sys/kernel/random/boot_id"; } 2>/dev/null
    live_device
    d=$R/sys/class/net/$DEV
    { read -r IDX < "$d/ifindex" && read -r RX < "$d/statistics/rx_bytes" &&
        read -r TX < "$d/statistics/tx_bytes"; } 2>/dev/null || { IDX= RX= TX=; }
    case $IDX$RX$TX in *[!0-9]*) IDX= RX= TX= ;; esac
    # available: the interface is there and not down (an existing but down interface carries nothing)
    AVAIL=0 st=
    { read -r st < "$d/operstate"; } 2>/dev/null
    [ -z "$RX" ] || [ "$st" = down ] || AVAIL=1
}
# live_device: DEV, the interface counted. An explicit DEVICE is it. auto: netifd's WAN device (OpenWrt), else the
# first sipa_eth that is up, else the one counted last (the ledger's base: data down for a moment changes nothing),
# else the active SIM slot's bearer (sipa_eth0 external, sipa_eth8 internal), else sipa_eth0. Only builtin reads
# unless netifd or mu300-sim is asked.
live_device() {
    DEV=$DEVICE
    [ "$DEV" = auto ] || return 0
    DEV=
    if openwrt && command -v ubus >/dev/null 2>&1; then
        DEV=$(ubus call "network.interface.$(wan)" status 2>/dev/null |
            sed -n 's/^[[:space:]]*"l3_device":[[:space:]]*"\([A-Za-z0-9_.:-]*\)".*/\1/p' | head -n1)
        case $DEV in sipa_eth[0-9]|sipa_eth[0-9][0-9]) return 0 ;; *) DEV= ;; esac
    fi
    for n in 0 8 1 9 2 10 3 11 4 12 5 13 6 14 7 15; do
        st=; { read -r st < "$R/sys/class/net/sipa_eth$n/operstate"; } 2>/dev/null
        [ "$st" = up ] && { DEV=sipa_eth$n; return 0; }
    done
    for f in "$LIVE" "$DISK"; do
        [ -s "$f" ] || continue
        while read -r k _ _ dv _; do
            [ "$k" = base ] || continue
            case $dv in sipa_eth[0-9]|sipa_eth[0-9][0-9]) DEV=$dv; return 0 ;; esac
        done < "$f"
    done
    s=$(mu300-sim active 2>/dev/null)
    case $s in 0|1) DEV=sipa_eth$((s * 8)) ;; *) DEV=sipa_eth0 ;; esac
    case $BOOT in *[!0-9a-f-]*) BOOT= ;; esac
}
# the clock is right: NTP said so (OpenWrt's hotplug, systemd-timesyncd), CLOCK=trust, or six hours went by without
clock_ok() {
    [ "$CLOCK" = trust ] || [ -e "$SYNCED" ] || [ -e "$R/run/systemd/timesync/synchronized" ] ||
        [ "${UP:-0}" -ge 21600 ]
}
# mobile data is not down on purpose (mobile-data down leaves this file until the next up)
data_up() { [ ! -e "$R/run/mu300-mobile-data-down" ]; }

# ------------------------------------------------------------------- the ledger
# One line per fact, in this order (numbers are bytes, times seconds):
#   mu300-traffic 1                  the format
#   since WALL                       counting started (the first reading with a right clock)
#   base BOOT IFINDEX DEV RX TX UP   the last reading of the counters, and its uptime
#   p BOOT UP RX TX                  pending: bytes counted while the clock was not right, per 15 minutes of uptime
#   d YYYY-MM-DD RX TX               one local day, oldest first (800 days are kept)
#   adj CYCLESTART BYTES [COUNT]     the correction "used" made to that billing cycle (may be negative), in that
#                                    count mode (total without one)
#   yadj YEARSTART BYTES [COUNT]     the same for the billing year (only while a yearly cap is set)
#   cut CYCLESTART BOOT OVERRIDE     the cap turned mobile data off in that cycle, in that boot; OVERRIDE 1: someone
#                                    turned it back on, it stays on
#   ycut YEARSTART BOOT OVERRIDE     the same for the yearly cap
#   alert CYCLESTART warn|over       the last warning logged in that cycle
#   yalert YEARSTART warn|over       the same for the billing year
#   dcut DAY BOOT OVERRIDE           the same for the daily quota, on that day
#   dalert DAY warn|over             the last warning about the daily quota logged that day
# The awk program reads a ledger, adds the reading given in -v (op sample/view), and prints the new ledger (fmt
# ledger) or a view of it (fmt text|json|days|cycles). It keeps to POSIX awk: no time functions (busybox, mawk,
# gawk and the BSD awk all differ there): local days come from the UTC offset (off).
AWK_LEDGER='
function isnum(x) { return x ~ /^-?[0-9]+$/ }
function civil(t,   z, era, doe, yoe, y, doy, mp, d, m) {
    z = int((t + off) / 86400) + 719468
    era = int(z / 146097); doe = z - era * 146097
    yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
    y = yoe + era * 400; doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
    mp = int((5 * doy + 2) / 153); d = doy - int((153 * mp + 2) / 5) + 1
    m = mp < 10 ? mp + 3 : mp - 9
    return sprintf("%04d-%02d-%02d", y + (m <= 2), m, d)
}
function nextmid(t) { return t - (t + off) % 86400 + 86400 }
function dim(y, m) {
    if (m == 2) return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 ? 29 : 28
    return m == 4 || m == 6 || m == 9 || m == 11 ? 30 : 31
}
function ymd(y, m, d) { return sprintf("%04d-%02d-%02d", y, m, d) }
function rday(y, m) { return reset > dim(y, m) ? dim(y, m) : reset }
# the first day of the billing cycle DAY is in, and of the one after the cycle starting at START
function cstart(day,   y, m, d) {
    y = substr(day, 1, 4) + 0; m = substr(day, 6, 2) + 0; d = substr(day, 9, 2) + 0
    if (d >= rday(y, m)) return ymd(y, m, rday(y, m))
    if (--m < 1) { m = 12; y-- }
    return ymd(y, m, rday(y, m))
}
function cnext(start,   y, m) {
    y = substr(start, 1, 4) + 0; m = substr(start, 6, 2) + 1
    if (m > 12) { m = 1; y++ }
    return ymd(y, m, rday(y, m))
}
# the first day of the billing year that starts in YEAR: yearly-start SS-MM-DD; 02-29 is 02-28 in a common year
function yfirst(y,   m, d) {
    m = substr(ystart, 1, 2) + 0; d = substr(ystart, 4, 2) + 0
    if (m == 2 && d == 29 && !(y % 4 == 0 && (y % 100 != 0 || y % 400 == 0))) d = 28
    return ymd(y, m, d)
}
# ycycle DAY: the first day of the billing year DAY is in, and of the one after the year starting at START
function ycycle(day,   y) {
    y = substr(day, 1, 4) + 0
    if (day < yfirst(y)) y--
    return yfirst(y)
}
function ynext(start,   y) { y = substr(start, 1, 4) + 0; return yfirst(y + 1) }
# dnum DAY: the number of the day (1970-01-01 is 0)
function dnum(s,   y, m, d, era, yoe, doy) {
    y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0; d = substr(s, 9, 2) + 0
    y -= m <= 2; era = int(y / 400); yoe = y - era * 400
    doy = int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
    return era * 146097 + yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy - 719468
}
function prevday(day,   y, m, d) {
    y = substr(day, 1, 4) + 0; m = substr(day, 6, 2) + 0; d = substr(day, 9, 2) - 1
    if (d < 1) { if (--m < 1) { m = 12; y-- }; d = dim(y, m) }
    return ymd(y, m, d)
}
# addday DAY RX TX: the days stay in order (a day before the last one is rare: pending bytes dated late)
function addday(k, rx, tx,   i) {
    if (!(k in drx)) {
        for (i = nk; i > 0 && key[i] > k; i--) key[i + 1] = key[i]
        key[i + 1] = k; nk++; drx[k] = 0; dtx[k] = 0
    }
    drx[k] += rx; dtx[k] += tx
}
# addspan T0 T1 RX TX: bytes counted over [T0, T1], shared out over the local days it covers by time; the rounding
# goes to the last day, so the sum is exact
function addspan(t0, t1, rx, tx,   a, b, prx, ptx) {
    if (t1 - t0 > 800 * 86400) t0 = t1 - 800 * 86400
    a = t0
    while (t1 > a && (b = nextmid(a)) < t1) {
        prx = int(rx * (b - a) / (t1 - a)); ptx = int(tx * (b - a) / (t1 - a))
        addday(civil(a), prx, ptx); rx -= prx; tx -= ptx; a = b
    }
    addday(civil(a), rx, tx)
}
function addpend(b, u, rx, tx,   k) {
    k = int(u / 900) * 900
    if (np > 0 && (np >= 2000 || (pb[np] == b && pu[np] == k))) { prx[np] += rx; ptx[np] += tx; return }
    np++; pb[np] = b; pu[np] = k; prx[np] = rx; ptx[np] = tx
}
# date the pending bytes: those of this boot by their uptime; older ones (a boot that never had a right clock)
# cannot be placed and go to today
function datepend(   i, t0, t1) {
    for (i = 1; i <= np; i++) {
        if (pb[i] == cboot && pu[i] <= up) {
            t0 = now - (up - pu[i]); t1 = t0 + 900; if (t1 > now) t1 = now
            addspan(t0, t1, prx[i], ptx[i])
        } else addday(civil(now), prx[i], ptx[i])
    }
    np = 0
}
function setbase() { hasb = 1; bboot = cboot; bidx = cidx; bdev = cdev; brx = crx; btx = ctx; bup = up }
function sample(   drx, dtx, span) {
    if (cboot == "" || crx == "") return
    if (!hasb || bdev != cdev) { setbase(); return }
    if (bboot == cboot && bidx == cidx) {
        drx = crx >= brx ? crx - brx : crx; dtx = ctx >= btx ? ctx - btx : ctx; span = up - bup
    } else {
        drx = crx; dtx = ctx; span = bboot == cboot ? up - bup : up
    }
    if (span < 0) span = 0
    setbase()
    if (drx + dtx == 0) return
    counted = drx + dtx
    if (trusted) addspan(now - span, now, drx, dtx); else addpend(cboot, up, drx, dtx)
}
function n(x) { return sprintf("%.0f", x) }
function hs(b,   u, i) {
    split("B KB MB GB TB", u, " "); i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    return (i == 1 ? sprintf("%d", b) : sprintf(b >= 100 ? "%.0f" : "%.1f", b)) " " u[i]
}
function sums(s, e,   i) {
    srx = 0; stx = 0
    for (i = 1; i <= nk; i++) if (key[i] >= s && key[i] < e) { srx += drx[key[i]]; stx += dtx[key[i]] }
}
function rank(l) { return l == "over" ? 2 : l == "warn" ? 1 : 0 }
# cnt RX TX: what the cap and the quota count (count total, rx or tx)
function cnt(rx, tx) { return mode == "rx" ? rx : mode == "tx" ? tx : rx + tx }
function lvl(u, lim) { return lim > 0 ? (u >= lim ? "over" : u * 100 >= lim * warn ? "warn" : "ok") : "none" }
# cutstep I KEY WANT: limit I (1 the cap, per cycle; 2 the daily quota, per day; 3 the yearly cap, per year) wants
# mobile data off for KEY or not; it is cut once per KEY and again after a reboot, unless someone turned it back on in
# the same boot
function cutstep(i, key, want) {
    if (ck[i] != "" && (ck[i] != key || !want)) {
        if (!co[i] && !dataup) rest = 1
        ck[i] = ""
    } else if (ck[i] != "" && !co[i]) {
        if (cb[i] == cboot) { if (dataup) co[i] = 1 }
        else { if (dataup && !docut) docut = i; cb[i] = cboot }
    }
    if (want && ck[i] == "") { ck[i] = key; cb[i] = cboot; co[i] = 0; if (dataup && !docut) docut = i }
}
function jstr(s,   o, i, c) {
    o = ""
    for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); if (c == "\\" || c == "\"") o = o "\\"; o = o c }
    return "\"" o "\""
}

$1 == "since" && isnum($2) { since = $2 }
$1 == "base" && NF == 7 && isnum($3) && isnum($5) && isnum($6) && isnum($7) {
    hasb = 1; bboot = $2; bidx = $3; bdev = $4; brx = $5; btx = $6; bup = $7
}
$1 == "p" && NF == 5 && isnum($3) && isnum($4) && isnum($5) { np++; pb[np] = $2; pu[np] = $3; prx[np] = $4; ptx[np] = $5 }
$1 == "d" && NF == 4 && $2 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ && isnum($3) && isnum($4) { addday($2, $3, $4) }
$1 == "adj" && (NF == 3 || NF == 4) && isnum($3) { adjc = $2; adjb = $3; adjm = NF == 4 ? $4 : "total" }
$1 == "yadj" && (NF == 3 || NF == 4) && isnum($3) { yadjc = $2; yadjb = $3; yadjm = NF == 4 ? $4 : "total" }
$1 == "cut" && NF == 4 { ck[1] = $2; cb[1] = $3; co[1] = $4 == 1 }
$1 == "ycut" && NF == 4 { ck[3] = $2; cb[3] = $3; co[3] = $4 == 1 }
$1 == "dcut" && NF == 4 { ck[2] = $2; cb[2] = $3; co[2] = $4 == 1 }
$1 == "alert" && NF == 3 { alc = $2; all = $3 }
$1 == "yalert" && NF == 3 { yalc = $2; yall = $3 }
$1 == "dalert" && NF == 3 { dalc = $2; dall = $3 }

END {
    today = civil(now)
    if (op == "sample" || op == "view" || op == "clear" || op == "used" || op == "yearly-used") sample()
    if (trusted && np) datepend()
    if (trusted && since == "" && op != "view") since = now
    if (op == "clear") {
        nk = 0; split("", drx); split("", dtx); np = 0; adjc = ""; ck[1] = ""; ck[2] = ""; alc = ""; dalc = ""; since = trusted ? now : ""
        yadjc = ""; ck[3] = ""; yalc = ""
    }
    cs = cstart(today); ce = cnext(cs)
    ys = ycycle(today); ye = ynext(ys)
    prx_all = 0; ptx_all = 0
    for (i = 1; i <= np; i++) { prx_all += prx[i]; ptx_all += ptx[i] }
    sums(cs, ce); crx_c = srx + prx_all; ctx_c = stx + ptx_all
    sums(ys, ye); yrx_c = srx + prx_all; ytx_c = stx + ptx_all
    if (op == "used") { adjc = cs; adjm = mode; adjb = usedarg - cnt(crx_c, ctx_c) }
    if (op == "yearly-used") { yadjc = ys; yadjm = mode; yadjb = usedarg - cnt(yrx_c, ytx_c) }
    adj = adjc == cs && adjm == mode ? adjb : 0
    used = cnt(crx_c, ctx_c) + adj; if (used < 0) used = 0
    level = lvl(used, cap); if (level == "none") level = "ok"
    # a yearly plan that was switched off keeps no correction of its own: only the days count
    if (yearly == 0) yadjc = ""
    yadj = yadjc == ys && yadjm == mode ? yadjb : 0
    yused = cnt(yrx_c, ytx_c) + yadj; if (yused < 0) yused = 0
    ylevel = lvl(yused, yearly)
    dused = cnt(drx[today] + prx_all, dtx[today] + ptx_all); dlevel = lvl(dused, daily)
    if (op == "sample") {
        if (alc != cs) { alc = cs; all = "ok" }
        if (rank(level) > rank(all)) { alert = level; all = level }
        if (rank(level) < rank(all)) all = level
        if (daily > 0) {
            if (dalc != today) { dalc = today; dall = "ok" }
            if (rank(dlevel) > rank(dall)) { dalert = dlevel; dall = dlevel }
            if (rank(dlevel) < rank(dall)) dall = dlevel
        } else dalc = ""
        if (yearly > 0) {
            if (yalc != ys) { yalc = ys; yall = "ok" }
            if (rank(ylevel) > rank(yall)) { yalert = ylevel; yall = ylevel }
            if (rank(ylevel) < rank(yall)) yall = ylevel
        } else yalc = ""
        cutstep(1, cs, cap > 0 && cut && level == "over")
        cutstep(2, today, daily > 0 && dcut && dlevel == "over")
        cutstep(3, ys, yearly > 0 && ycut && ylevel == "over")
        # back on only when no limit still holds it off
        restore = rest && !docut && (ck[1] == "" || co[1]) && (ck[2] == "" || co[2]) && (ck[3] == "" || co[3])
        # 800 days are kept
        old = civil(now - 800 * 86400); j = 0
        for (i = 1; i <= nk; i++) if (key[i] >= old) key[++j] = key[i]; else { delete drx[key[i]]; delete dtx[key[i]] }
        nk = j
        if (sumfile != "")
            printf "level=%s\nalert=%s\ncut=%d\ncut_by=%s\nrestore=%d\ncounted=%s\nused=%s\ncap=%s\nwarn=%d\ncycle_start=%s\ntoday_rx=%s\ntoday_tx=%s\npending=%s\nclock=%d\ndaily_level=%s\ndaily_alert=%s\ndaily_used=%s\ndaily=%s\nremaining=%s\nyearly=%s\nyearly_level=%s\nyearly_used=%s\nyearly_remaining=%s\nyearly_alert=%s\nyearly_cut=%d\n", \
                (cap > 0 ? level : "none"), alert, (docut > 0), (docut == 2 ? "daily" : docut == 3 ? "yearly" : docut ? "cap" : ""), restore, \
                n(counted), n(used), n(cap), warn, cs, n(drx[today]), n(dtx[today]), n(prx_all + ptx_all), \
                trusted, dlevel, dalert, n(dused), n(daily), \
                n(cap > 0 ? cap - used : 0), n(yearly), (yearly > 0 ? ylevel : "none"), n(yused), \
                n(yearly > 0 ? yearly - yused : 0), (yalert == "" ? "ok" : yalert), (docut == 3) > sumfile
    }
    if (fmt == "ledger") {
        print "mu300-traffic 1"
        if (since != "") print "since " since
        if (hasb) printf "base %s %s %s %s %s %s\n", bboot, bidx, bdev, n(brx), n(btx), n(bup)
        for (i = 1; i <= np; i++) printf "p %s %s %s %s\n", pb[i], pu[i], n(prx[i]), n(ptx[i])
        for (i = 1; i <= nk; i++) printf "d %s %s %s\n", key[i], n(drx[key[i]]), n(dtx[key[i]])
        if (adjc != "") printf "adj %s %s%s\n", adjc, n(adjb), (adjm != "" && adjm != "total" ? " " adjm : "")
        if (yadjc != "") printf "yadj %s %s%s\n", yadjc, n(yadjb), (yadjm != "" && yadjm != "total" ? " " yadjm : "")
        if (ck[1] != "") printf "cut %s %s %d\n", ck[1], cb[1], co[1]
        if (ck[3] != "") printf "ycut %s %s %d\n", ck[3], cb[3], co[3]
        if (alc != "") printf "alert %s %s\n", alc, all
        if (yalc != "") printf "yalert %s %s\n", yalc, yall
        if (ck[2] != "") printf "dcut %s %s %d\n", ck[2], cb[2], co[2]
        if (dalc != "") printf "dalert %s %s\n", dalc, dall
        exit
    }
    last = prevday(ce)
    left = dnum(last) - dnum(today) + 1
    ylast = prevday(ye)
    yleft = dnum(ylast) - dnum(today) + 1
    if (fmt == "json") {
        printf "{\"device\":\"%s\",\"available\":%d,\"clock\":%d,\"since\":%s,\"now\":%s,\"reset_day\":%d,", \
            dev, (avail == 1), trusted, (since == "" ? "null" : n(since)), n(now), reset
        printf "\"plan\":%s,\"count\":\"%s\",", jstr(ENVIRON["MU300_TRAFFIC_PLAN"]), mode
        printf "\"today\":{\"date\":\"%s\",\"rx\":%s,\"tx\":%s},", today, n(drx[today]), n(dtx[today])
        printf "\"pending\":{\"rx\":%s,\"tx\":%s},", n(prx_all), n(ptx_all)
        printf "\"cycle\":{\"start\":\"%s\",\"last\":\"%s\",\"days_left\":%d,\"rx\":%s,\"tx\":%s,\"adj\":%s,\"used\":%s},", \
            cs, last, left, n(crx_c), n(ctx_c), n(adj), n(used)
        printf "\"cap\":{\"bytes\":%s,\"remaining\":%s,\"warn\":%d,\"cut\":%d,\"level\":\"%s\",\"cut_active\":%d},", \
            n(cap), n(cap > 0 ? cap - used : 0), warn, cut, (cap > 0 ? level : "none"), (ck[1] == cs && !co[1])
        printf "\"yearly\":{\"start_day\":%s,\"start\":\"%s\",\"last\":\"%s\",\"days_left\":%d,\"bytes\":%s,\"used\":%s,\"remaining\":%s,\"cut\":%d,\"level\":\"%s\",\"cut_active\":%d},", \
            jstr(ystart), ys, ylast, yleft, n(yearly), n(yused), n(yearly > 0 ? yearly - yused : 0), ycut, (yearly > 0 ? ylevel : "none"), (ck[3] == ys && !co[3])
        printf "\"daily\":{\"bytes\":%s,\"used\":%s,\"cut\":%d,\"level\":\"%s\",\"cut_active\":%d},", \
            n(daily), n(dused), dcut, dlevel, (ck[2] == today && !co[2])
        printf "\"days\":["
        c = 0
        for (i = nk; i > 0 && c < ndays; i--) if (key[i] <= today) printf "%s{\"date\":\"%s\",\"rx\":%s,\"tx\":%s}", (c++ ? "," : ""), key[i], n(drx[key[i]]), n(dtx[key[i]])
        printf "],\"cycles\":["
        s = cs
        for (c = 0; c < ncyc; c++) {
            sums(s, cnext(s)); if (s == cs) { srx += prx_all; stx += ptx_all }
            if (c > 0 && (!nk || cnext(s) <= key[1])) break
            a = adjc == s && adjm == mode ? adjb : 0; u = cnt(srx, stx) + a
            printf "%s{\"start\":\"%s\",\"last\":\"%s\",\"rx\":%s,\"tx\":%s,\"adj\":%s,\"used\":%s}", (c ? "," : ""), s, prevday(cnext(s)), n(srx), n(stx), n(a), n(u < 0 ? 0 : u)
            s = cstart(prevday(s))
        }
        print "]}"
    } else if (fmt == "days") {
        c = 0
        for (i = nk; i > 0 && c < ndays; i--) if (key[i] <= today) {
            printf "%s  down %9s  up %9s  total %9s\n", key[i], hs(drx[key[i]]), hs(dtx[key[i]]), hs(drx[key[i]] + dtx[key[i]]); c++
        }
        if (!c) print "no traffic counted yet"
    } else if (fmt == "cycles") {
        s = cs
        for (c = 0; c < ncyc; c++) {
            sums(s, cnext(s)); if (s == cs) { srx += prx_all; stx += ptx_all }
            if (c > 0 && (!nk || cnext(s) <= key[1])) break
            a = adjc == s && adjm == mode ? adjb : 0; u = cnt(srx, stx) + a
            printf "%s - %s  down %9s  up %9s  %s %9s%s\n", s, prevday(cnext(s)), hs(srx), hs(stx), \
                (mode == "total" ? "total" : "counted"), hs(u < 0 ? 0 : u), \
                (a ? " (corrected by " (a < 0 ? "-" hs(-a) : "+" hs(a)) ")" : "")
            s = cstart(prevday(s))
        }
    } else {
        printf "mobile data on %s%s\n", dev, (avail == 1 ? "" : " (not there now)")
        if (ENVIRON["MU300_TRAFFIC_PLAN"] != "") printf "plan          %s\n", ENVIRON["MU300_TRAFFIC_PLAN"]
        if (mode != "total") printf "counted       %s only (the cap and the quota count that way)\n", (mode == "rx" ? "downloads" : "uploads")
        printf "today         %s  down %s, up %s\n", today, hs(drx[today]), hs(dtx[today])
        printf "this cycle    %s - %s  %s used", cs, last, hs(used)
        if (cap > 0) printf " of %s (%d%%)", hs(cap), int(used * 100 / cap)
        printf ", "
        if (cap > 0) printf "%s left, ", hs(cap - used > 0 ? cap - used : 0)
        printf "%d day%s left\n", left, (left == 1 ? "" : "s")
        if (adj) printf "              corrected by %s (mu300-traffic used)\n", (adj < 0 ? "-" hs(-adj) : "+" hs(adj))
        if (prx_all + ptx_all) printf "not dated yet %s: the clock has not been set by NTP (counted in this cycle)\n", hs(prx_all + ptx_all)
        if (cap > 0) {
            printf "cap           %s, warning at %d%%; at the cap mobile data %s\n", hs(cap), warn, (cut ? "is turned off" : "stays on")
            if (level == "over") print "              the cap is reached" (ck[1] == cs && !co[1] ? ": mobile data was turned off" : "")
            else if (level == "warn") print "              warning: " int(used * 100 / cap) "% of the cap is used"
        } else print "cap           none (mu300-traffic set cap 50G)"
        if (daily > 0) {
            printf "daily quota   %s, %s used today (%d%%); at the quota mobile data %s\n", hs(daily), hs(dused), \
                int(dused * 100 / daily), (dcut ? "is turned off until midnight" : "stays on")
            if (dlevel == "over") print "              the daily quota is reached" (ck[2] == today && !co[2] ? ": mobile data was turned off" : "")
        }
        if (yearly > 0) {
            printf "this year     %s - %s  %s used of %s (%d%%), %s left, %d day%s left\n", ys, ylast, hs(yused), hs(yearly), \
                int(yused * 100 / yearly), hs(yearly - yused > 0 ? yearly - yused : 0), yleft, (yleft == 1 ? "" : "s")
            printf "yearly cap    %s, warning at %d%%; at the yearly cap mobile data %s\n", hs(yearly), warn, (ycut ? "is turned off" : "stays on")
            if (ylevel == "over") print "              the yearly cap is reached" (ck[3] == ys && !co[3] ? ": mobile data was turned off" : "")
            else if (ylevel == "warn") print "              warning: " int(yused * 100 / yearly) "% of the yearly cap is used"
            if (yadj) printf "              corrected by %s (mu300-traffic yearly-used)\n", (yadj < 0 ? "-" hs(-yadj) : "+" hs(yadj))
        } else print "yearly        none (mu300-traffic set yearly 500G)"
        if (since != "") printf "counting since %s\n", civil(since)
    }
}
'

# ledger_run OP FMT [VAR=VALUE...]: the awk program on the current ledger with a reading taken now
ledger_run() {
    _op=$1 _fmt=$2; shift 2
    counters
    uptime_v; clock
    clock_ok && _t=1 || _t=0
    data_up && _du=1 || _du=0
    _src=$LIVE; [ -s "$_src" ] || _src=$DISK; [ -s "$_src" ] || _src=/dev/null
    MU300_TRAFFIC_PLAN=$PLAN awk -v op="$_op" -v fmt="$_fmt" -v now="$NOW" -v off="$OFF" -v up="${UP:-0}" -v trusted="$_t" \
        -v cboot="$BOOT" -v cidx="$IDX" -v cdev="$DEV" -v crx="$RX" -v ctx="$TX" -v dev="$DEV" -v avail="$AVAIL" \
        -v reset="$RESET_DAY" -v cap="$CAP" -v warn="$WARN" -v cut="$CUT" -v dataup="$_du" \
        -v daily="$DAILY" -v dcut="$DAILY_CUT" -v mode="$COUNT" -v ystart="$YEARLY_START" \
        -v yearly="$YEARLY" -v ycut="$YEARLY_CUT" \
        -v ndays="${NDAYS:-31}" -v ncyc="${NCYC:-12}" -v usedarg="${USED:-0}" -v sumfile="${SUMFILE:-}" \
        "$@" "$AWK_LEDGER" "$_src"
}

# ------------------------------------------------------------------- locking
# lock / unlock: one writer of the live ledger at a time (the service's reading, a change made here). A lock whose
# owner is gone is taken over.
lock() {
    [ -d "$RUN" ] || mkdir -p "$RUN" || die "cannot create $RUN"
    i=0
    while ! mkdir "$LOCK" 2>/dev/null; do
        p=$(cat "$LOCK/pid" 2>/dev/null)
        if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$LOCK"; continue; fi
        i=$((i + 1)); [ "$i" -le 50 ] || die "the ledger is locked ($LOCK)"
        sleep 1
    done
    echo $$ > "$LOCK/pid"
}
unlock() { rm -rf "$LOCK"; }

# update OP: a reading taken now, OP applied, the live ledger replaced (the caller holds the lock)
update() {
    ledger_run "$@" > "$RUN/ledger.new" && [ -s "$RUN/ledger.new" ] && mv "$RUN/ledger.new" "$LIVE"
}
# save: the live ledger onto the disk (a new file renamed over the old one)
save() {
    [ -s "$LIVE" ] || return 0
    mkdir -p "$STORE" && cp "$LIVE" "$DISK.new" && mv "$DISK.new" "$DISK"
}
# change OP ...: a change made here, kept at once (live and on the disk)
change() {
    lock
    if [ ! -s "$LIVE" ] && [ -s "$DISK" ]; then cp "$DISK" "$LIVE"; fi
    update "$@" || { unlock; die "the ledger could not be written"; }
    save || { unlock; die "the ledger could not be saved to $STORE"; }
    unlock
}

# ---------------------------------------------------------------- the service
log() { logger -t mu300-traffic "$*" 2>/dev/null || echo "mu300-traffic: $*" >&2; }
openwrt() { [ -f "$R/etc/openwrt_release" ]; }
wan() { w=$(uci -q get unisoc_modem.main.data_interface 2>/dev/null); case $w in ''|*[!A-Za-z0-9_]*) w=wan ;; esac; echo "$w"; }
data_off() {
    if openwrt; then ifdown "$(wan)"; else systemctl stop mu300-mobile-data.service; fi
}
data_on() {
    if openwrt; then ifup "$(wan)"; else systemctl start mu300-mobile-data.service; fi
}

# one round: read, write the live ledger and the summary, act on what the summary says
round() {
    lock
    SUMFILE=$SUMMARY.new update sample ledger && mv "$SUMMARY.new" "$SUMMARY"
    unlock
    # the summary's lines, read by the shell (one sed per value used to be most of a round's processes)
    s_counted= s_alert= s_warn= s_used= s_cap= s_cut= s_cut_by= s_restore= s_daily_alert= s_daily_used= s_daily=
    s_yearly_alert= s_yearly_used= s_yearly=
    { while IFS= read -r _l; do
        case $_l in
            counted=*) s_counted=${_l#*=} ;; alert=*) s_alert=${_l#*=} ;; warn=*) s_warn=${_l#*=} ;;
            used=*) s_used=${_l#*=} ;; cap=*) s_cap=${_l#*=} ;; cut=*) s_cut=${_l#*=} ;; cut_by=*) s_cut_by=${_l#*=} ;;
            restore=*) s_restore=${_l#*=} ;; daily_alert=*) s_daily_alert=${_l#*=} ;;
            daily_used=*) s_daily_used=${_l#*=} ;; daily=*) s_daily=${_l#*=} ;;
            yearly_alert=*) s_yearly_alert=${_l#*=} ;; yearly_used=*) s_yearly_used=${_l#*=} ;;
            yearly=*) s_yearly=${_l#*=} ;;
        esac
    done < "$SUMMARY"; } 2>/dev/null
    case $s_counted in ''|*[!0-9]*) s_counted=0 ;; esac
    UNSAVED=$((UNSAVED + s_counted))
    case $s_alert in
        warn) log "$s_warn% of the monthly cap is used ($s_used of $s_cap bytes this cycle)" ;;
        over) log "the monthly cap is reached ($s_used of $s_cap bytes this cycle)" ;;
    esac
    case $s_daily_alert in
        warn) log "$s_warn% of the daily quota is used ($s_daily_used of $s_daily bytes today)" ;;
        over) log "the daily quota is reached ($s_daily_used of $s_daily bytes today)" ;;
    esac
    case $s_yearly_alert in
        warn) log "$s_warn% of the yearly cap is used ($s_yearly_used of $s_yearly bytes this year)" ;;
        over) log "the yearly cap is reached ($s_yearly_used of $s_yearly bytes this year)" ;;
    esac
    if [ "$s_cut" = 1 ]; then
        if [ "$s_cut_by" = daily ]; then
            log "turning mobile data off at the daily quota until midnight (to keep it on: mu300-traffic set daily-cut off, or a higher quota)"
        elif [ "$s_cut_by" = yearly ]; then
            log "turning mobile data off at the yearly cap (to keep it on: mu300-traffic set yearly-cut off, or a higher yearly cap)"
        else
            log "turning mobile data off at the monthly cap (to keep it on: mu300-traffic set cut off, or a higher cap)"
        fi
        data_off >/dev/null 2>&1 &
    fi
    if [ "$s_restore" = 1 ]; then
        log "turning mobile data back on: no cap, quota or yearly cap holds it off any more"
        data_on >/dev/null 2>&1 &
    fi
}
# conf_changed: the settings file is not what load_conf read last (the shell reads it: a few lines); load_conf's nine
# seds and greps run only then
conf_seen=-
conf_changed() {
    _cf=
    { while IFS= read -r _l || [ -n "$_l" ]; do _cf="$_cf$_l
"; done < "$CONF"; } 2>/dev/null
    [ "$_cf" != "$conf_seen" ] || return 1
    conf_seen=$_cf
}
checkpoint() { save && LAST_SAVE=$(uptime_s) && UNSAVED=0; }

run() {
    conf_changed || :; load_conf
    mkdir -p "$RUN" "$STORE" || die "cannot create $RUN or $STORE"
    # the wait's timer (and those of what this starts: awk, date) may fire up to half a second late, so the kernel can
    # serve the timers of several daemons with one wakeup (FINDINGS 235)
    { echo 500000000 > /proc/$$/timerslack_ns; } 2>/dev/null
    # one service: another one alive keeps its place
    p=$(cat "$RUN/pid" 2>/dev/null)
    if [ -n "$p" ] && [ "$p" != $$ ] && kill -0 "$p" 2>/dev/null; then die "already running (pid $p)"; fi
    echo $$ > "$RUN/pid"
    # the live ledger of this boot, or the one on the disk
    [ -s "$LIVE" ] || { [ -s "$DISK" ] && cp "$DISK" "$LIVE"; }
    stop= UNSAVED=0 LAST_SAVE=$(uptime_s)
    trap 'stop=1' TERM INT HUP
    round
    checkpoint
    while :; do
        if [ -z "$stop" ]; then
            sleep "$INTERVAL" & pid=$!
            wait "$pid" 2>/dev/null || true
            kill "$pid" 2>/dev/null
        fi
        if conf_changed; then load_conf; fi   # a setting changed meanwhile applies to this round
        round
        if [ -n "$stop" ]; then checkpoint; rm -f "$RUN/pid"; exit 0; fi
        uptime_v
        if [ $((UP - LAST_SAVE)) -ge "$CHECKPOINT" ] ||
           { [ "$UNSAVED" -ge "$CHECKPOINT_BYTES" ] && [ $((UP - LAST_SAVE)) -ge 300 ]; }; then
            checkpoint
        fi
    done
}

load_conf
case "${1:-status}" in
    status) ledger_run view text ;;
    days)   [ -z "${2:-}" ] || case $2 in *[!0-9]*) die "days N: a number" ;; esac
            NDAYS=${2:-31} ledger_run view days ;;
    cycles) [ -z "${2:-}" ] || case $2 in *[!0-9]*) die "cycles N: a number" ;; esac
            NCYC=${2:-12} ledger_run view cycles ;;
    json)   NDAYS=${2:-62} ledger_run view json ;;
    set)
        v=${3:-}
        case ${2:-} in
            used-remaining)
                       _b=$(size_bytes "$v") || die "used-remaining: a size like 12.5G"
                       [ "$CAP" -gt 0 ] || die "used-remaining: no cap is set (mu300-traffic set cap 50G)"
                       [ "$_b" -le "$CAP" ] || die "used-remaining: the remaining ($v) is more than the cap ($CAP bytes)"
                       USED=$((CAP - _b)); change used ledger
                       echo "this cycle now counts as $((CAP - _b)) bytes used (the cap less the remaining)"
                       exit 0 ;;
            yearly-used-remaining)
                       _b=$(size_bytes "$v") || die "yearly-used-remaining: a size like 12.5G"
                       [ "$YEARLY" -gt 0 ] || die "yearly-used-remaining: no yearly cap is set (mu300-traffic set yearly 500G)"
                       [ "$_b" -le "$YEARLY" ] ||
                           die "yearly-used-remaining: the remaining ($v) is more than the yearly cap ($YEARLY bytes)"
                       USED=$((YEARLY - _b)); change yearly-used ledger
                       echo "this year now counts as $((YEARLY - _b)) bytes used (the yearly cap less the remaining)"
                       exit 0 ;;
            reset-day) printf '%s\n' "$v" | grep -Eqx '[1-9]|[12][0-9]|3[01]' || die "reset-day: a day from 1 to 31"
                       write_conf RESET_DAY "$v" ;;
            cap)       case $v in off|0) v=0 ;; *) v=$(size_bytes "$v") || die "cap: a size like 50G, or off" ;; esac
                       write_conf CAP "$v" ;;
            warn)      printf '%s\n' "$v" | grep -Eqx '[1-9]|[1-9][0-9]|100' || die "warn: a percentage from 1 to 100"
                       write_conf WARN "$v" ;;
            cut)       case $v in on) v=1 ;; off) v=0 ;; *) die "cut: on or off" ;; esac
                       write_conf CUT "$v" ;;
            daily)     case $v in off|0) v=0 ;; *) v=$(size_bytes "$v") || die "daily: a size like 2G, or off" ;; esac
                       write_conf DAILY "$v" ;;
            daily-cut) case $v in on) v=1 ;; off) v=0 ;; *) die "daily-cut: on or off" ;; esac
                       write_conf DAILY_CUT "$v" ;;
            yearly)    case $v in off|0) v=0 ;; *) v=$(size_bytes "$v") || die "yearly: a size like 500G, or off" ;; esac
                       write_conf YEARLY "$v" ;;
            yearly-start) yearly_start_ok "$v" || die "yearly-start: a date MM-DD like 01-01"
                       write_conf YEARLY_START "$v" ;;
            yearly-cut) case $v in on) v=1 ;; off) v=0 ;; *) die "yearly-cut: on or off" ;; esac
                       write_conf YEARLY_CUT "$v" ;;
            count)     case $v in total|rx|tx) ;; *) die "count: total, rx or tx" ;; esac
                       write_conf COUNT "$v" ;;
            plan)      [ "$(printf '%s' "$v" | wc -l)" -eq 0 ] && printf '%s\n' "$v" | LC_ALL=C grep -Eqx -- "$PLAN_ERE" ||
                           die "plan: one line of at most 96 bytes, no control character"
                       write_conf PLAN "$v" ;;
            device)    printf '%s\n' "$v" | grep -Eqx 'auto|[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}' || die "device: an interface name, or auto"
                       write_conf DEVICE "$v" ;;
            *) die "set reset-day|cap|warn|cut|daily|daily-cut|count|plan|device|yearly|yearly-start|yearly-cut|used-remaining|yearly-used-remaining VALUE" ;;
        esac
        echo "saved" ;;
    used)
        USED=$(size_bytes "${2:-}") || die "used: a size like 12.5G"
        change used ledger
        echo "this cycle now counts as $2 used" ;;
    yearly-used)
        USED=$(size_bytes "${2:-}") || die "yearly-used: a size like 12.5G"
        [ "$YEARLY" -gt 0 ] || die "yearly-used: no yearly cap is set (mu300-traffic set yearly 500G)"
        change yearly-used ledger
        echo "this year now counts as $2 used" ;;
    clear)
        [ "${2:-}" = --yes ] || die "clear --yes: forgets every count"
        change clear ledger
        echo "cleared" ;;
    save)   # a round of the service now, and the disk copy
        mkdir -p "$RUN" || die "cannot create $RUN"
        [ -s "$LIVE" ] || { [ -s "$DISK" ] && cp "$DISK" "$LIVE"; }
        UNSAVED=0; round; save || die "the ledger could not be saved to $STORE" ;;
    run) run ;;
    clock-synced) mkdir -p "${SYNCED%/*}" && : > "$SYNCED" ;;
    *) sed -n '2,33s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
